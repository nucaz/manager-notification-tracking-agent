<%- include('../partials/head', { title: title }) %>
<% const qs = [['modulo', filters.module], ['estado', filters.status], ['q', filters.q]].filter(function (kv) { return kv[1]; }).map(function (kv) { return kv[0] + '=' + encodeURIComponent(kv[1]); }).join('&'); %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
  <h2 class="mb-0">Solicitudes</h2>
  <div class="d-flex gap-2">
    <a href="/solicitudes/exportar.xlsx<%= qs ? '?' + qs : '' %>" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-excel"></i> Exportar</a>
    <% if (currentUser.role !== 'lector' && enabledModules.m365) { %><a href="/m365/solicitudes/nueva" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Solicitud de Microsoft 365</a><% } %>
  </div>
</div>
<p class="small text-muted">Quién pidió qué, para quién y cuándo, en todos los módulos: asignaciones de celulares, usuarios de Clinic y cuentas de Microsoft 365.
  Busque por el nombre del jefe o gerente para ver todo lo que solicitó.</p>

<form class="row g-2 mb-3" method="get">
  <div class="col-md-4"><label class="visually-hidden" for="f_q">Buscar</label>
    <input type="text" name="q" id="f_q" value="<%= filters.q %>" class="form-control" placeholder="Solicitante, para quién o referencia..."></div>
  <div class="col-md-3"><label class="visually-hidden" for="f_mod">Módulo</label>
    <select name="modulo" id="f_mod" class="form-select"><option value="">Todos los módulos</option>
      <% Object.keys(MODULES).forEach(function (k) { %><option value="<%= k %>" <%= filters.module === k ? 'selected' : '' %>><%= MODULES[k] %></option><% }); %></select></div>
  <div class="col-md-3"><label class="visually-hidden" for="f_est">Estado</label>
    <select name="estado" id="f_est" class="form-select"><option value="">Todos los estados</option>
      <option value="abiertas" <%= filters.status === 'abiertas' ? 'selected' : '' %>>Abiertas (pendientes o en curso)</option>
      <% Object.keys(STATUS).forEach(function (k) { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= STATUS[k].label %></option><% }); %></select></div>
  <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="submit">Filtrar</button></div>
</form>

<div class="card p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr><th>N.º</th><th>Fecha</th><th>Módulo</th><th>Tipo</th><th>Solicitado por</th><th>Para</th><th>Estado</th><th>Pasos</th></tr></thead>
      <tbody>
        <% items.forEach(function (r) { %>
          <tr>
            <td><a href="/solicitudes/<%= r.id %>">#<%= r.id %></a></td>
            <td class="text-nowrap"><%= String(r.request_date).slice(0, 10) %></td>
            <td class="small"><%= MODULES[r.module] %></td>
            <td class="small"><%= TYPE_LABELS[r.request_type] || r.request_type %></td>
            <td><%= r.requested_by_name %><div class="small text-muted"><%= [r.requested_by_cargo, r.requested_by_area].filter(Boolean).join(', ') %><%= r.request_ref ? ' · ' + r.request_ref : '' %></div></td>
            <td class="small"><% if (r.entity_id && ENTITY_URL[r.module]) { %><a href="<%= ENTITY_URL[r.module] + r.entity_id %>"><%= r.beneficiary_name || 'ver' %></a><% } else { %><%= r.beneficiary_name || '—' %><% } %></td>
            <td><span class="badge <%= (STATUS[r.status] || {}).badge %>"><%= (STATUS[r.status] || {}).label || r.status %></span></td>
            <td class="small"><%= r.tasks_total ? r.tasks_done + ' de ' + r.tasks_total : '—' %></td>
          </tr>
        <% }); %>
        <% if (!items.length) { %><tr><td colspan="8" class="text-center text-muted py-4">No hay solicitudes con esos filtros.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
