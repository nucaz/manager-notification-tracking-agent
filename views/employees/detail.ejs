<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h2 class="mb-0"><%= employee.first_name %> <%= employee.last_name %></h2>
    <span class="text-muted">DNI <%= employee.dni %><% if (employee.cargo) { %> · <%= employee.cargo %><% } %></span>
  </div>
  <div>
    <% if (currentUser.role !== 'lector') { %>
      <a href="/empleados/<%= employee.id %>/editar" class="btn btn-outline-primary">Editar</a>
    <% } %>
    <a href="/empleados" class="btn btn-outline-secondary">Volver</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card p-3 mb-3">
      <h5>Datos del empleado</h5>
      <table class="table table-sm">
        <tr><th style="width:160px;">Área</th><td><%= employee.area || '—' %></td></tr>
        <tr><th>Sede</th><td><%= employee.sede || '—' %></td></tr>
        <tr><th>Cargo</th><td><%= employee.cargo || '—' %></td></tr>
        <tr><th>Notas</th><td><%= employee.notes || '—' %></td></tr>
      </table>
    </div>

    <div class="card p-3 mb-3">
      <h5>Historial de asignaciones (reasignaciones)</h5>
      <% if (assignmentHistory.length === 0) { %>
        <p class="text-muted mb-0">Sin asignaciones registradas.</p>
      <% } else { %>
        <table class="table table-sm">
          <thead><tr><th>Equipo</th><th>Desde</th><th>Hasta</th><th>Observación</th></tr></thead>
          <tbody>
            <% assignmentHistory.forEach(function(a) { %>
              <tr>
                <td><a href="/celulares/<%= a.device_id %>"><%= a.imei %></a> <%= a.asset_code ? '(' + a.asset_code + ')' : '' %></td>
                <td><%= a.assigned_date || '—' %></td>
                <td><%= a.returned_date || 'Activa' %></td>
                <td><%= a.observacion || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card p-3">
      <h5>Reparaciones, accidentes y bajas de sus equipos</h5>
      <% if (incidents.length === 0) { %>
        <p class="text-muted mb-0">Sin incidentes registrados en los equipos que ha tenido.</p>
      <% } else { %>
        <table class="table table-sm">
          <thead><tr><th>Fecha</th><th>Equipo</th><th>Tipo</th><th>Descripción</th><th>Costo</th><th>Resuelta</th></tr></thead>
          <tbody>
            <% incidents.forEach(function(inc) { %>
              <tr>
                <td><%= inc.fecha %></td>
                <td><a href="/celulares/<%= inc.device_id %>"><%= inc.imei %></a></td>
                <td>
                  <span class="badge <%= inc.tipo === 'reparacion' ? 'bg-warning text-dark' : inc.tipo === 'baja' ? 'bg-danger' : 'bg-secondary' %>">
                    <%= inc.tipo %>
                  </span>
                </td>
                <td><%= inc.descripcion || '—' %></td>
                <td><%= inc.costo != null ? inc.costo : '—' %></td>
                <td>
                  <% if (inc.tipo !== 'reparacion') { %>—<% } else if (inc.fecha_resolucion) { %>Sí (<%= inc.fecha_resolucion %>)<% } else { %>No<% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card p-3 mb-3">
      <h5>Celular(es) asignado(s) actualmente</h5>
      <% if (currentDevices.length === 0) { %>
        <p class="text-muted">Sin celular asignado.</p>
      <% } else { %>
        <ul class="list-group list-group-flush mb-3">
          <% currentDevices.forEach(function(d) { %>
            <li class="list-group-item px-0">
              <a href="/celulares/<%= d.id %>"><strong><%= d.imei %></strong></a>
              <%= d.asset_code ? '(' + d.asset_code + ')' : '' %><br>
              <span class="text-muted small"><%= [d.brand, d.model].filter(Boolean).join(' / ') || 'Sin marca/modelo' %> · desde <%= d.assigned_date || '—' %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <% if (currentUser.role !== 'lector') { %>
        <% currentDevices.forEach(function(d) { %>
          <button class="btn btn-sm btn-outline-danger mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#formIncidente<%= d.id %>">
            Registrar incidente en <%= d.imei %>
          </button>
          <div class="collapse mb-3" id="formIncidente<%= d.id %>">
            <form action="/celulares/<%= d.id %>/incidentes" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="/empleados/<%= employee.id %>">
              <div class="mb-2">
                <label class="form-label small">Tipo *</label>
                <select name="tipo" class="form-select form-select-sm" required>
                  <option value="reparacion">Reparación</option>
                  <option value="accidente">Accidente (registro informativo)</option>
                  <option value="baja">Baja por daño</option>
                </select>
              </div>
              <div class="mb-2">
                <label class="form-label small">Fecha *</label>
                <input type="date" name="fecha" class="form-control form-control-sm" required value="<%= new Date().toISOString().slice(0,10) %>">
              </div>
              <div class="mb-2">
                <label class="form-label small">Descripción</label>
                <textarea name="descripcion" class="form-control form-control-sm" rows="2"></textarea>
              </div>
              <div class="mb-2">
                <label class="form-label small">Costo (opcional)</label>
                <input type="number" step="0.01" min="0" name="costo" class="form-control form-control-sm">
              </div>
              <button type="submit" class="btn btn-sm btn-danger">Guardar incidente</button>
            </form>
          </div>
        <% }); %>

        <hr>
        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#formAsignarCelular">
          Asignar un celular disponible
        </button>
        <div class="collapse mt-2" id="formAsignarCelular">
          <% if (availableDevices.length === 0) { %>
            <p class="text-muted small mb-0">No hay celulares en stock para asignar.</p>
          <% } else { %>
            <form action="/empleados/<%= employee.id %>/asignar-celular" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-2">
                <label class="form-label small">Celular en stock *</label>
                <select name="device_id" class="form-select form-select-sm" required>
                  <option value="">— Seleccionar —</option>
                  <% availableDevices.forEach(function(d) { %>
                    <option value="<%= d.id %>"><%= d.imei %> <%= d.asset_code ? '(' + d.asset_code + ')' : '' %> — <%= [d.brand, d.model].filter(Boolean).join(' ') %></option>
                  <% }); %>
                </select>
              </div>
              <div class="mb-2">
                <label class="form-label small">Turno</label>
                <input type="text" name="turno" class="form-control form-control-sm" placeholder="Mañana, Tarde...">
              </div>
              <div class="mb-2">
                <label class="form-label small">Fecha de entrega</label>
                <input type="date" name="assigned_date" class="form-control form-control-sm">
              </div>
              <div class="mb-2">
                <label class="form-label small">Observación</label>
                <input type="text" name="observacion" class="form-control form-control-sm">
              </div>
              <button type="submit" class="btn btn-sm btn-primary">Confirmar asignación</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
