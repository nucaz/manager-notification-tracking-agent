<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Empleados</h2>
  <% if (currentUser.role !== 'lector') { %>
    <a href="/empleados/nuevo" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo empleado</a>
  <% } %>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-auto">
    <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Buscar por DNI, nombres o apellidos...">
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
  </div>
</form>

<div class="card p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr><th>DNI</th><th>Nombres</th><th>Apellidos</th><th>Área</th><th>Sede</th><th>Cargo</th><th></th></tr></thead>
      <tbody>
        <% items.forEach(function(e) { %>
          <tr>
            <td><%= e.dni %></td>
            <td><%= e.first_name %></td>
            <td><%= e.last_name %></td>
            <td><%= e.area || '—' %></td>
            <td><%= e.sede || '—' %></td>
            <td><%= e.cargo || '—' %></td>
            <td class="text-end">
              <% if (currentUser.role !== 'lector') { %>
                <a href="/empleados/<%= e.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
                <form action="/empleados/<%= e.id %>/eliminar" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este empleado? Sus asignaciones anteriores quedan en el historial igual.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (items.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No hay empleados registrados.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
