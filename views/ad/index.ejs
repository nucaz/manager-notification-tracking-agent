<%- include('../partials/head', { title: title }) %>
<%- include('_tabs') %>
<% const sum = run && run.summary; const u = ov.users; const c = ov.computers;
   const totalSeen = Object.values(tramos).reduce(function (a, b) { return a + b; }, 0) || 1;
   const TONE = { ok: 'bg-success', warn: 'bg-warning', bad: 'bg-danger' };
   const certDays = sum && sum.cert && sum.cert.validTo ? Math.round((new Date(sum.cert.validTo) - Date.now()) / 86400000) : null; %>

<% if (sum && sum.notes && sum.notes.length) { %>
  <div class="alert alert-warning small" data-aviso="ad-lectura-avisos"><strong>Avisos de la última lectura:</strong>
    <ul class="mb-0"><% sum.notes.forEach(function (n) { %><li><%= n %></li><% }); %></ul></div>
<% } %>

<% const L = function (n, href, cls) { return '<a class="' + (cls || 'link-body-emphasis') + '" href="' + href + '">' + n + '</a>'; }; %>
<div class="row g-3 mb-3" style="font-variant-numeric: tabular-nums" id="ad_indicadores">
  <div class="col-md-3 col-6"><div class="card p-3 h-100"><div class="small text-muted">Usuarios habilitados</div>
    <div class="fs-3 fw-semibold"><%- L(u.enabled, '/ad/usuarios?f=habilitados', 'link-body-emphasis text-decoration-none') %></div>
    <div class="small text-muted"><%- L(u.disabled, '/ad/usuarios?f=deshabilitados') %> deshabilitados<% if (u.locked) { %> · <%- L(u.locked, '/ad/usuarios?f=bloqueados') %> bloqueados<% } %></div></div></div>
  <div class="col-md-3 col-6"><div class="card p-3 h-100 border-danger"><div class="small text-muted">Con privilegios de administración</div>
    <div class="fs-3 fw-semibold"><%- L(u.privileged, '/ad/usuarios?f=privilegiados', 'link-danger text-decoration-none') %></div>
    <div class="small text-muted">usuarios habilitados en <a href="/ad/grupos?f=privilegiados">grupos privilegiados</a> (incluidos anidados)</div></div></div>
  <div class="col-md-3 col-6"><div class="card p-3 h-100"><div class="small text-muted">Sin conectarse en <%= IDLE_DAYS %> días</div>
    <div class="fs-3 fw-semibold"><%- L(u.idle, '/ad/usuarios?f=inactivos', 'link-warning text-decoration-none') %></div>
    <div class="small text-muted"><%- L(u.neverLogged, '/ad/usuarios?f=nunca') %> nunca entraron · <%- L(u.neverExpires, '/ad/usuarios?f=no_vence') %> con contraseña que no vence</div></div></div>
  <div class="col-md-3 col-6"><div class="card p-3 h-100"><div class="small text-muted">Equipos habilitados</div>
    <div class="fs-3 fw-semibold"><%- L(c.enabled, '/ad/equipos?f=habilitados', 'link-body-emphasis text-decoration-none') %></div>
    <div class="small text-muted"><%- L(c.dcs, '/ad/equipos?f=dc') %> controlador(es) · <%- L(c.idle, '/ad/equipos?f=inactivos') %> inactivos <%= IDLE_DAYS %> días
      · <%- L(c.noDns, '/ad/equipos?f=sin_dns') %> sin DNS</div></div></div>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-6">
    <div class="card p-3 h-100">
      <h5>Grupos privilegiados</h5>
      <p class="small text-muted mb-2">Miembros efectivos habilitados (directos y por grupos anidados). Se identifican por SID, no por nombre.</p>
      <table class="table table-sm small mb-0" data-tabla="no" style="font-variant-numeric: tabular-nums">
        <thead><tr><th>Grupo</th><th class="text-end">Usuarios</th></tr></thead>
        <tbody>
          <% ov.privileged.forEach(function (g) { %>
            <tr><td><a href="/ad/grupos/<%= g.id %>"><%= g.name %></a> <span class="text-muted">· <%= PRIVILEGED_LABEL[g.privileged] %></span></td>
              <td class="text-end <%= g.n ? 'fw-semibold' : 'text-muted' %>"><% if (g.n) { %><a href="/ad/grupos/<%= g.id %>"><%= g.n %></a><% } else { %>0<% } %></td></tr>
          <% }); %>
          <% if (!ov.privileged.length) { %><tr><td colspan="2" class="text-muted">Sin datos: lea el dominio.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card p-3 h-100">
      <h5>Última conexión de los usuarios habilitados</h5>
      <div class="d-flex flex-column gap-2 mt-1">
        <% BUCKETS.forEach(function (b) { const n = tramos[b.key] || 0; %>
          <a class="d-flex align-items-center gap-2 small text-reset text-decoration-none" style="font-variant-numeric: tabular-nums" href="/ad/usuarios?tramo=<%= b.key %>"
            title="Ver los <%= n %> usuarios habilitados de este tramo">
            <span style="width: 130px; flex: none" class="link-primary"><%= b.label %></span>
            <span class="flex-grow-1 bg-body-tertiary rounded" style="height: 1.1rem"><span class="d-block h-100 rounded <%= TONE[b.tone] %>" style="width: <%= (n * 100 / totalSeen).toFixed(1) %>%"></span></span>
            <span style="width: 50px; flex: none" class="text-end"><strong><%= n %></strong></span>
          </a>
        <% }); %>
      </div>
      <div class="form-text">La más reciente entre <code>lastLogon</code> (de cada DC consultado) y <code>lastLogonTimestamp</code> (replicado, hasta ~14 días de desfase).</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card p-3 h-100">
      <h5>Dominio</h5>
      <% if (!sum) { %><p class="text-muted small mb-0">Sin datos: lea el dominio.</p><% } else { %>
      <table class="table table-sm small mb-0" data-tabla="no">
        <tr><th style="width: 220px">Dominio</th><td><%= sum.domain %> <span class="text-muted">(<%= sum.baseDn %>)</span></td></tr>
        <tr><th>Nivel funcional</th><td>Windows Server <%= sum.domainLevel %></td></tr>
        <tr><th>Controladores de dominio</th><td><% sum.dcs.forEach(function (d) { %><div><%= d.dc %> <%- d.ok ? '<span class="text-success">✓</span>' : '<span class="text-danger">no respondió</span>' %></div><% }); %></td></tr>
        <tr><th>Papelera de reciclaje de AD</th><td><%- sum.recycleBin ? '<span class="text-success">Habilitada</span>' : '<span class="text-warning-emphasis">No habilitada (lo eliminado no se puede restaurar con sus atributos)</span>' %></td></tr>
        <tr><th>Certificado LDAPS</th><td><% if (sum.cert && sum.cert.validTo) { %><%= sum.cert.subject %> · vence <%= String(sum.cert.validTo).slice(0, 10) %>
          <span class="<%= certDays !== null && certDays < 30 ? 'text-danger fw-semibold' : 'text-muted' %>">(<%= certDays %> días)</span><% } else { %>—<% } %></td></tr>
        <tr><th>Contraseñas</th><td>mínimo <%= sum.policy.minPwdLength %> caracteres · vencen a los <%= sum.policy.maxPwdAgeDays || 'nunca' %> días · historial <%= sum.policy.pwdHistory %></td></tr>
        <tr><th>Bloqueo de cuentas</th><td><%= sum.policy.lockoutThreshold ? 'tras ' + sum.policy.lockoutThreshold + ' intentos, ' + sum.policy.lockoutMinutes + ' min' : '<span class="text-warning-emphasis">sin bloqueo por intentos fallidos</span>' %></td></tr>
      </table>
      <% } %>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card p-3 h-100">
      <h5>Equipos por sistema operativo</h5>
      <table class="table table-sm small mb-2" data-tabla="no" style="font-variant-numeric: tabular-nums">
        <tbody><% ov.os.forEach(function (o) { const h = '/ad/equipos?so=' + encodeURIComponent(o.os); %>
          <tr><td><a href="<%= h %>"><%= o.os %></a></td><td class="text-end"><a href="<%= h %>"><%= o.n %></a></td></tr><% }); %></tbody>
      </table>
      <div class="small">
        <a href="/ad/dns">DNS</a>: <%= ov.dns.total %> registros · <a class="<%= ov.dns.withoutComputer ? 'link-warning fw-semibold' : '' %>" href="/ad/dns?f=huerfanos"><%= ov.dns.withoutComputer %> sin equipo en AD</a>
        · <a href="/ad/papelera">Papelera</a>: <%= ov.deleted %> objeto(s)
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
