<%# Confirmacion de identidad antes de cambiar el dominio, aprobar o dar permisos. %>
<div class="border rounded p-3 mb-3 bg-body-tertiary">
  <% if (reauth === 'codigo') { %>
    <label class="form-label" for="reauth_code"><i class="bi bi-shield-lock"></i> Código de su app de autenticación *</label>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <input class="form-control font-monospace" id="reauth_code" name="reauth_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6"
        required style="max-width: 10rem">
      <div class="small" id="reauth_reloj" data-ahora="<%= Date.now() %>" aria-live="polite" style="min-width: 14rem">
        <div class="progress mb-1" style="height: 4px"><div class="progress-bar" id="reauth_barra" style="width: 100%"></div></div>
        <span id="reauth_texto" class="text-muted"></span>
      </div>
    </div>
    <div class="form-text">Escríbalo <strong>al final</strong>, justo antes de guardar: el código cambia cada 30 segundos. Si el que escribió ya venció, se le avisa antes de enviar
      (no cuenta como intento fallido). Cinco intentos fallidos bloquean estas acciones 15 minutos.</div>
    <script>
    (function () {
      // Reloj del servidor (no el de esta PC) para saber cuanto le queda al codigo del celular.
      const reloj = document.getElementById('reauth_reloj');
      const desfase = Number(reloj.dataset.ahora) - Date.now();
      const paso = function () { return Math.floor((Date.now() + desfase) / 30000); };
      const input = document.getElementById('reauth_code');
      const texto = document.getElementById('reauth_texto');
      const barra = document.getElementById('reauth_barra');
      let escritoEn = null; // paso en que se escribio el codigo
      input.addEventListener('input', function () { escritoEn = this.value ? paso() : null; this.setCustomValidity(''); });
      // El servidor acepta el codigo del paso actual y el del anterior: vence al terminar el siguiente.
      const vencido = function () { return escritoEn !== null && paso() > escritoEn + 1; };
      const tic = function () {
        const resta = 30 - Math.floor(((Date.now() + desfase) / 1000) % 30);
        barra.style.width = (resta / 30 * 100) + '%';
        barra.className = 'progress-bar ' + (resta <= 5 ? 'bg-warning' : '');
        if (vencido()) {
          texto.className = 'text-danger fw-semibold';
          texto.textContent = 'El código que escribió ya venció: escriba el que muestra ahora su celular.';
        } else {
          texto.className = 'text-muted';
          texto.textContent = 'El código de su celular cambia en ' + resta + ' s' + (resta <= 5 && !input.value ? ' (espere el siguiente)' : '') + '.';
        }
      };
      tic();
      setInterval(tic, 1000);
      input.form.addEventListener('submit', function (e) {
        if (!vencido() || (e.submitter && e.submitter.formNoValidate)) return;
        e.preventDefault();
        input.value = '';
        escritoEn = null;
        input.setCustomValidity('El código ya venció: escriba el actual.');
        input.reportValidity();
        input.focus();
      });
    })();
    </script>
  <% } else { %>
    <label class="form-label" for="reauth_password"><i class="bi bi-shield-lock"></i> Su contraseña de esta aplicación *</label>
    <input class="form-control" type="password" id="reauth_password" name="reauth_password" autocomplete="current-password" required style="max-width: 20rem">
    <div class="form-text">Se pide para confirmar que es usted. Cinco intentos fallidos bloquean estas acciones 15 minutos.</div>
  <% } %>
</div>
