<%- include('../partials/head', { title: title }) %>
<%- include('_tabs') %>
<% // Arbol: cada unidad debajo de su padre (por DN), con lo que contiene directamente.
   // Cada rama se contrae y expande (<details>); al buscar quedan solo las ramas que coinciden.
   const esc = function (t) { return String(t === null || t === undefined ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); };
   const byParent = {};
   items.forEach(function (o) { const k = String(o.parent_dn || '').toLowerCase(); (byParent[k] = byParent[k] || []).push(o); });
   const known = new Set(items.map(function (o) { return String(o.dn).toLowerCase(); }));
   const roots = items.filter(function (o) { return !known.has(String(o.parent_dn || '').toLowerCase()); });
   const kidsOf = function (o) { return (byParent[String(o.dn).toLowerCase()] || []).sort(function (a, b) { return a.name.localeCompare(b.name, 'es'); }); };
   const needle = String(q || '').toLowerCase();
   const hit = function (o) { return !needle || [o.name, o.dn, o.description].some(function (v) { return v && String(v).toLowerCase().indexOf(needle) > -1; }); };
   // Equipos de cada unidad (directos), para verlos al expandirla.
   const pcsBy = {};
   (locals.computers || []).forEach(function (c) { const k = String(c.ou_dn || '').toLowerCase(); (pcsBy[k] = pcsBy[k] || []).push(c); });
   const pcsOf = function (o) { return pcsBy[String(o.dn).toLowerCase()] || []; };
   const pcHit = function (c) { return !!needle && [c.name, c.dns_host, c.ips, c.os, c.description].some(function (v) { return v && String(v).toLowerCase().indexOf(needle) > -1; }); };
   const keep = function (o) { return hit(o) || pcsOf(o).some(pcHit) || kidsOf(o).some(keep); };
   let shownPcs = 0;
   const pcList = function (o) {
     const all = pcsOf(o);
     const list = needle && !hit(o) ? all.filter(pcHit) : all;
     if (!list.length) return '';
     shownPcs += list.length;
     const rows = list.slice().sort(function (a, b) { return a.name.localeCompare(b.name, 'es'); }).map(function (c) {
       const b = bucket(c.last_seen);
       const old = c.enabled && !c.is_dc && /año|Nunca/.test(b);
       return '<li class="d-flex flex-wrap align-items-center gap-2 py-1 small border-bottom' + (pcHit(c) ? ' bg-warning-subtle' : '') + '">'
         + '<i class="bi ' + (c.is_dc ? 'bi-hdd-rack text-primary' : 'bi-pc-display') + '"></i>'
         + '<a class="font-monospace" href="/ad/equipos?q=' + encodeURIComponent(c.name) + '">' + esc(c.name) + '</a>'
         + (c.is_dc ? ' <span class="badge text-bg-primary">DC</span>' : '')
         + (c.enabled ? '' : ' <span class="badge text-bg-secondary">Deshabilitado</span>')
         + '<span class="text-muted">' + esc(c.os || 'Sin sistema operativo') + '</span>'
         + '<span class="ms-auto d-inline-flex gap-3" style="font-variant-numeric: tabular-nums">'
         + '<span class="font-monospace">' + esc(c.ips || (c.is_dc ? '' : 'Sin DNS')) + '</span>'
         + '<span class="' + (old ? 'text-danger fw-semibold' : 'text-muted') + '" title="Última conexión">' + esc(b) + '</span></span></li>';
     }).join('');
     return '<li class="ou-equipos"><details' + (needle && list.some(pcHit) ? ' open' : '') + '><summary class="ou-rama small text-muted py-1">'
       + '<div class="d-inline"><i class="bi bi-pc-display"></i> Equipos (' + list.length + (list.length < all.length ? ' de ' + all.length : '') + ')</div></summary>'
       + '<ul class="list-unstyled ps-4 mb-1">' + rows + '</ul></details></li>';
   };
   let shown = 0;
   const mng = function (dn) { return locals.canChange && writes.ready && writes.managedOus.some(function (m) { const d = String(dn).toLowerCase(), x = m.toLowerCase(); return d === x || d.endsWith(',' + x); }); };
   const crear = function (o) {
     if (!mng(o.dn)) return '';
     return ' <span class="small d-inline-flex gap-2">' + [['user_create', 'usuario'], ['group_create', 'grupo'], ['computer_create', 'equipo'], ['ou_create', 'sub-unidad']]
       .map(function (x) { return '<a href="/ad/cambios/nuevo?op=' + x[0] + '&id=' + o.id + '">+ ' + x[1] + '</a>'; }).join('') + '</span>';
   };
   const count = function (n, what, href) { return n ? '<a href="' + href + '">' + n + ' ' + what + '</a>' : '0 ' + what; };
   const line = function (o) {
     const q2 = encodeURIComponent(o.dn);
     return '<div class="d-flex flex-wrap align-items-center gap-2 py-1 border-bottom' + (needle && hit(o) ? ' bg-warning-subtle' : '') + '">'
       + '<i class="bi ' + (o.kind === 'ou' ? 'bi-folder2-open text-warning' : 'bi-box text-secondary') + '"></i>'
       + '<strong>' + esc(o.name) + '</strong>'
       + (o.kind === 'ou' ? '' : ' <span class="badge text-bg-light border">contenedor</span>')
       + (mng(o.dn) ? ' <span class="badge text-bg-success-subtle text-success-emphasis border" title="Unidad gestionada: se pueden hacer cambios">gestionada</span>' + crear(o) : '')
       + '<span class="small text-muted ms-auto" style="font-variant-numeric: tabular-nums">'
       + count(o.users_count, 'usuarios', '/ad/usuarios?q=' + q2) + ' · ' + count(o.computers_count, 'equipos', '/ad/equipos?q=' + q2) + ' · '
       + count(o.groups_count, 'grupos', '/ad/grupos?q=' + q2) + '</span></div>'
       + (o.description ? '<div class="small text-muted ps-4">' + esc(o.description) + '</div>' : '');
   };
   const draw = function (o, level) {
     if (!keep(o)) return '';
     shown += 1;
     const kids = kidsOf(o).filter(keep);
     const pcs = pcList(o);
     if (!kids.length && !pcs) return '<li class="ou-nodo ps-3">' + line(o) + '</li>';
     return '<li class="ou-nodo"><details' + (needle || level < 1 ? ' open' : '') + '><summary class="ou-rama">' + line(o) + '</summary>'
       + '<ul class="list-unstyled ps-4 mb-0">' + pcs + kids.map(function (k) { return draw(k, level + 1); }).join('') + '</ul></details></li>';
   };
   const tree = roots.sort(function (a, b) { return a.dn.localeCompare(b.dn); }).map(function (r) { return draw(r, 0); }).join(''); %>
<style>
  .ou-rama { list-style: none; cursor: pointer; }
  .ou-rama::-webkit-details-marker { display: none; }
  .ou-rama > div::before { content: '\25B8'; display: inline-block; width: 1em; color: var(--bs-secondary-color); transition: transform .15s; }
  details[open] > .ou-rama > div::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: reduce) { .ou-rama > div::before { transition: none; } }
</style>
<div class="card p-3">
  <form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-2" role="search">
    <label class="visually-hidden" for="ad_q">Buscar unidad organizativa</label>
    <input type="search" class="form-control form-control-sm" id="ad_q" name="q" value="<%= q %>" placeholder="Unidad, DN o equipo (nombre, IP)…" style="max-width: 20rem">
    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button>
    <% if (q) { %><span class="small text-muted"><%= shown %> de <%= items.length %> unidades<%= shownPcs ? ' · ' + shownPcs + ' equipo(s)' : '' %></span> <a class="small" href="/ad/unidades">Quitar búsqueda</a><% } %>
    <span class="ms-auto d-flex gap-2">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-arbol="abrir"><i class="bi bi-arrows-expand"></i> Expandir todo</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-arbol="cerrar"><i class="bi bi-arrows-collapse"></i> Contraer todo</button>
    </span>
  </form>
  <p class="small text-muted mb-2"><%= items.length %> unidades organizativas y contenedores. Las cifras son lo que contiene cada una directamente; clic en ellas para verlos. Al expandir una unidad se ven sus equipos.</p>
  <ul class="list-unstyled mb-0" id="ad_arbol"><%- tree %></ul>
  <% if (!items.length) { %><p class="text-muted mb-0">Sin datos: lea el dominio.</p><% } else if (!shown) { %><p class="text-muted mb-0">Ninguna unidad coincide con la búsqueda.</p><% } %>
</div>
<script>
document.querySelectorAll('[data-arbol]').forEach(function (b) {
  b.addEventListener('click', function () {
    var open = b.getAttribute('data-arbol') === 'abrir';
    document.querySelectorAll('#ad_arbol details').forEach(function (d) { d.open = open; });
  });
});
// Los enlaces dentro de una rama no la contraen.
document.querySelectorAll('#ad_arbol summary a').forEach(function (a) { a.addEventListener('click', function (ev) { ev.stopPropagation(); }); });
</script>
<%- include('../partials/foot') %>
