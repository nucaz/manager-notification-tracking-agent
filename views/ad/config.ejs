<%- include('../partials/head', { title: title }) %>
<%- include('_tabs') %>
<div class="row g-3">
  <div class="col-lg-7">
    <form method="post" action="/ad/configuracion" class="card p-4" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h5>Conexión al controlador de dominio (LDAPS)</h5>
      <p class="small text-muted">Solo un superadministrador ve y cambia esta pantalla. Al guardar se <strong>prueba la conexión</strong>: si el certificado no valida con la CA
        o la cuenta no entra, no se guarda nada.</p>
      <div class="mb-3"><label class="form-label" for="ad_url">Servidor *</label>
        <input class="form-control font-monospace" id="ad_url" name="ad_url" required placeholder="ldaps://dc01.depilzone.local:636" value="<%= cfg.url %>">
        <div class="form-text">Solo <code>ldaps://</code> (puerto 636). El nombre debe coincidir con el del certificado del DC.</div></div>
      <div class="mb-3"><label class="form-label" for="ad_bind_user">Cuenta de servicio *</label>
        <input class="form-control font-monospace" id="ad_bind_user" name="ad_bind_user" required placeholder="svc-gestor@depilzone.local" value="<%= cfg.bindUser %>"></div>
      <div class="mb-3"><label class="form-label" for="ad_bind_password">Contraseña de la cuenta de servicio <%= cfg.password ? '' : '*' %></label>
        <input class="form-control" type="password" id="ad_bind_password" name="ad_bind_password" autocomplete="new-password"
          placeholder="<%= cfg.password ? 'Configurada - dejar vacío para mantenerla' : '' %>" <%= cfg.password ? '' : 'required' %>>
        <div class="form-text">Se guarda cifrada. Nunca se vuelve a mostrar.</div></div>
      <div class="mb-3"><label class="form-label" for="ad_ca_pem">Certificados de confianza (PEM) *</label>
        <textarea class="form-control font-monospace small" id="ad_ca_pem" name="ad_ca_pem" rows="6" required placeholder="-----BEGIN CERTIFICATE-----"><%= cfg.caPem %></textarea>
        <div class="form-text">El certificado raíz de su CA interna o, si cada DC usa un certificado autofirmado, el de <strong>cada</strong> DC, uno debajo del otro.
          Solo se confía en lo que pegue aquí: no hay opción de aceptar cualquier certificado.</div></div>
      <div class="mb-3"><label class="form-label" for="ad_base_dn">DN base (opcional)</label>
        <input class="form-control font-monospace" id="ad_base_dn" name="ad_base_dn" placeholder="Se detecta solo (por ejemplo DC=ad,DC=depilzone,DC=com,DC=pe)" value="<%= cfg.baseDn %>"></div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="ad_all_dcs" name="ad_all_dcs" value="1" <%= cfg.allDcs ? 'checked' : '' %>>
        <label class="form-check-label" for="ad_all_dcs">Consultar todos los controladores de dominio para la última conexión exacta (<code>lastLogon</code> no se replica)</label></div>
      <div><button class="btn btn-primary"><i class="bi bi-shield-check"></i> Probar y guardar</button></div>
    </form>

    <form method="post" action="/ad/configuracion/escritura" class="card p-4 mt-3 <%= wcfg.enabled ? 'border-warning' : '' %>" autocomplete="off" id="ad_escritura">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h5>Cambios en el dominio</h5>
      <p class="small text-muted">Crear, modificar, deshabilitar, desbloquear, restablecer contraseñas, grupos, equipos con su DNS y restaurar de la papelera.
        Un superadministrador ejecuta directo; los demás piden aprobación o usan un permiso temporal. Al guardar encendido se <strong>prueba</strong> la cuenta y
        que existan las unidades organizativas.</p>
      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="ad_writes_enabled" name="ad_writes_enabled" value="1" <%= wcfg.enabled ? 'checked' : '' %>>
        <label class="form-check-label" for="ad_writes_enabled"><strong>Permitir cambios en el dominio</strong></label></div>
      <div class="mb-3"><label class="form-label" for="ad_write_user">Cuenta de escritura (recomendado: distinta de la de lectura)</label>
        <input class="form-control font-monospace" id="ad_write_user" name="ad_write_user" placeholder="svc-gestor-escritura@ad.depilzone.com.pe" value="<%= wcfg.writeUser %>">
        <div class="form-text">Vacío = usa la cuenta de lectura (que entonces necesita la delegación de escritura).</div></div>
      <div class="mb-3"><label class="form-label" for="ad_write_password">Contraseña de la cuenta de escritura</label>
        <input class="form-control" type="password" id="ad_write_password" name="ad_write_password" autocomplete="new-password"
          placeholder="<%= wcfg.hasWritePassword ? 'Configurada - dejar vacío para mantenerla' : '' %>">
        <div class="form-text">Se guarda cifrada. Nunca se vuelve a mostrar.</div></div>
      <% // OU del dominio en orden de arbol, con su profundidad; las ya gestionadas vienen marcadas.
         const ouOnly = ouList.filter(function (o) { return o.kind === 'ou'; });
         const lc = function (s) { return String(s || '').toLowerCase(); };
         const ouKnown = new Set(ouOnly.map(function (o) { return lc(o.dn); }));
         const ouKids = {};
         ouOnly.forEach(function (o) { const k = ouKnown.has(lc(o.parent_dn)) ? lc(o.parent_dn) : ''; (ouKids[k] = ouKids[k] || []).push(o); });
         const ouRows = [];
         const walk = function (k, depth) { (ouKids[k] || []).sort(function (a, b) { return a.name.localeCompare(b.name, 'es'); })
           .forEach(function (o) { ouRows.push({ o: o, depth: depth }); walk(lc(o.dn), depth + 1); }); };
         walk('', 0);
         const chosen = new Set(wcfg.managedOus.map(lc));
         const typedOnly = wcfg.managedOus.filter(function (dn) { return !ouKnown.has(lc(dn)); }); %>
      <div class="mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <span class="form-label mb-0">Unidades organizativas gestionadas *</span>
          <span class="badge text-bg-secondary" id="ou_contador"></span>
          <div class="ms-auto d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary" id="ou_detectar"><i class="bi bi-search"></i> Detectar las delegadas a la cuenta</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ou_todas">Todas</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ou_ninguna">Ninguna</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ou_abrir" title="Expandir todo"><i class="bi bi-arrows-expand"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ou_cerrar" title="Contraer todo"><i class="bi bi-arrows-collapse"></i></button>
          </div>
        </div>
        <div class="alert small py-2 mb-2" id="ou_aviso" role="status" hidden></div>
        <% if (ouRows.length) { %>
          <input type="search" class="form-control form-control-sm mb-2" id="ou_filtro" placeholder="Filtrar unidades…" style="max-width: 20rem" aria-label="Filtrar unidades">
          <div class="border rounded" style="max-height: 22rem; overflow: auto" id="ou_lista">
            <% ouRows.forEach(function (r) { const o = r.o; const dc = /^ou=domain controllers,/i.test(o.dn); %>
              <div class="ou-fila d-flex align-items-center gap-2 px-2 py-1 border-bottom small" data-dn="<%= lc(o.dn) %>" data-padre="<%= lc(o.parent_dn) %>"
                data-texto="<%= lc(o.name + ' ' + o.dn) %>" style="padding-left: <%= 0.5 + r.depth * 1.25 %>rem !important">
                <% if ((ouKids[lc(o.dn)] || []).length) { %><button type="button" class="btn btn-sm btn-link p-0 text-body-secondary ou-plegar" aria-expanded="true"
                  aria-label="Expandir o contraer <%= o.name %>" style="width: 1.1rem"><i class="bi bi-chevron-down"></i></button>
                <% } else { %><span style="width: 1.1rem; flex: none"></span><% } %>
                <input class="form-check-input m-0" type="checkbox" name="ad_managed_ou" value="<%= o.dn %>" id="ou_<%= o.id %>"
                  <%= chosen.has(lc(o.dn)) ? 'checked' : '' %> <%= dc ? 'disabled' : '' %> data-propio="<%= chosen.has(lc(o.dn)) ? '1' : '0' %>">
                <label class="form-check-label flex-grow-1" for="ou_<%= o.id %>" title="<%= o.dn %>"><i class="bi bi-folder2"></i> <%= o.name %>
                  <% if (dc) { %><span class="text-muted">(nunca: controladores de dominio)</span><% } %></label>
                <span class="ou-marca"></span>
                <span class="text-muted text-nowrap" style="font-variant-numeric: tabular-nums" title="Usuarios · equipos · grupos (directos)">
                  <i class="bi bi-person"></i> <%= o.users_count %> <i class="bi bi-pc-display ms-1"></i> <%= o.computers_count %> <i class="bi bi-people ms-1"></i> <%= o.groups_count %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="small text-muted">Lea el dominio primero (Resumen → Leer ahora) para elegir de la lista.</div>
        <% } %>
        <div class="form-text">Solo se cambia lo que está dentro de las unidades marcadas y sus sub-unidades (al marcar una, sus sub-unidades quedan incluidas).
          Las cuentas privilegiadas y los controladores de dominio nunca, estén donde estén. <strong>Detectar</strong> entra con la cuenta de escritura y marca
          las unidades donde el dominio le dio control delegado; no cambia nada en el dominio.</div>
        <details class="mt-2" <%= typedOnly.length ? 'open' : '' %>><summary class="small">Escribir un DN a mano (una por línea)</summary>
          <textarea class="form-control font-monospace small mt-1" id="ad_managed_ous" name="ad_managed_ous" rows="3"
            placeholder="OU=Sedes,DC=ad,DC=empresa,DC=com"><%= typedOnly.join(String.fromCharCode(10)) %></textarea></details>
      </div>
      <%- include('_reauth') %>
      <div><button class="btn btn-warning"><i class="bi bi-shield-check"></i> Probar y guardar</button></div>
    </form>
  </div>
  <div class="col-lg-5">
    <div class="card p-3">
      <h6>Cuenta de servicio de lectura</h6>
      <ol class="small mb-2">
        <li>Un usuario propio (ej. <code>svc-gestor</code>), <strong>sin</strong> ser administrador del dominio, con contraseña larga y aleatoria.</li>
        <li>Para leer el directorio basta con ser usuario del dominio. Para ver la <strong>papelera</strong>:
          <code>dsacls "CN=Deleted Objects,DC=…" /takeownership</code> y <code>dsacls "CN=Deleted Objects,DC=…" /g "DOMINIO\svc-gestor:LCRP"</code>.</li>
        <li>En sus propiedades marque "La cuenta es importante y no se puede delegar" y "La contraseña nunca expira" solo si la rota usted a mano.</li>
        <li>En el firewall, permita solo desde el servidor de la aplicación hacia los DC por el puerto <strong>636</strong>.</li>
        <li>Revise en el DC los eventos de inicio de sesión de esta cuenta: solo debe entrar desde la IP del servidor de la aplicación.</li>
      </ol>
    </div>
    <div class="card p-3 mt-3">
      <h6>Cuenta de escritura (cambios en el dominio)</h6>
      <ol class="small mb-2">
        <li>Otro usuario propio (ej. <code>svc-gestor-escritura</code>), <strong>sin</strong> ser administrador del dominio ni de ningún grupo privilegiado.</li>
        <li>En cada OU gestionada, con <em>Delegar control</em>: crear, eliminar y administrar cuentas de usuario, restablecer contraseñas y leer/escribir
          <code>lockoutTime</code> y <code>pwdLastSet</code>, modificar la pertenencia a grupos, crear y eliminar objetos de equipo, crear unidades organizativas.</li>
        <li>Para borrar el DNS de un equipo eliminado: control sobre la zona del dominio (y las inversas) en
          <code>CN=MicrosoftDNS,DC=DomainDnsZones,…</code>, no el grupo DnsAdmins.</li>
        <li>Para restaurar de la papelera: <code>dsacls "DC=…" /G "DOMINIO\svc-gestor-escritura:CA;Reanimate Tombstones"</code> y listar/leer/escribir en
          <code>CN=Deleted Objects</code> (tomando antes la propiedad).</li>
        <li>Como la de lectura: "La cuenta es importante y no se puede delegar", contraseña larga, solo desde la IP del servidor por el puerto 636.</li>
      </ol>
      <div class="small text-muted">AD también protege a los administradores (AdminSDHolder): aunque la delegación sea amplia, el dominio no deja a esta cuenta tocarlos.
        La aplicación, además, los bloquea antes de intentarlo.</div>
    </div>
  </div>
</div>
<script>
(function () {
  const form = document.getElementById('ad_escritura');
  if (!form) return;
  const filas = Array.from(form.querySelectorAll('.ou-fila'));
  const caja = function (f) { return f.querySelector('input[type=checkbox]'); };
  const porDn = {};
  filas.forEach(function (f) { porDn[f.dataset.dn] = f; });
  const esDc = function (f) { return /^ou=domain controllers,/.test(f.dataset.dn); };
  // Una OU queda "incluida" si alguna de arriba esta marcada por el usuario.
  const ancestroMarcado = function (f) {
    for (let p = porDn[f.dataset.padre]; p; p = porDn[p.dataset.padre]) if (caja(p).dataset.propio === '1') return true;
    return false;
  };
  const contador = document.getElementById('ou_contador');
  const pintar = function () {
    let n = 0;
    filas.forEach(function (f) {
      const c = caja(f);
      if (esDc(f)) return;
      const inc = ancestroMarcado(f);
      c.disabled = inc;
      c.checked = inc || c.dataset.propio === '1';
      f.classList.toggle('text-body-secondary', inc);
      f.title = inc ? 'Incluida por la unidad de arriba' : '';
      if (!inc && c.checked) n++;
    });
    if (contador) contador.textContent = n ? n + ' elegida(s)' : 'ninguna elegida';
  };
  filas.forEach(function (f) { caja(f).addEventListener('change', function () { this.dataset.propio = this.checked ? '1' : '0'; pintar(); }); });
  const marcar = function (fn) { filas.forEach(function (f) { if (!esDc(f)) caja(f).dataset.propio = fn(f) ? '1' : '0'; }); pintar(); };
  const raiz = function (f) { return !porDn[f.dataset.padre]; };
  document.getElementById('ou_todas').addEventListener('click', function () { marcar(raiz); });
  document.getElementById('ou_ninguna').addEventListener('click', function () { marcar(function () { return false; }); });
  // Ramas plegables: una fila se oculta si alguna de arriba esta contraida. Al filtrar se ve todo lo que coincide.
  const filtro = document.getElementById('ou_filtro');
  const cerradas = new Set();
  const mostrar = function () {
    const q = filtro ? filtro.value.trim().toLowerCase() : '';
    filas.forEach(function (f) {
      let oculta = false;
      if (q) oculta = f.dataset.texto.indexOf(q) < 0;
      else for (let p = porDn[f.dataset.padre]; p; p = porDn[p.dataset.padre]) if (cerradas.has(p.dataset.dn)) { oculta = true; break; }
      f.hidden = oculta;
      const b = f.querySelector('.ou-plegar');
      if (b) {
        const abierta = !cerradas.has(f.dataset.dn);
        b.setAttribute('aria-expanded', abierta ? 'true' : 'false');
        b.firstElementChild.className = 'bi ' + (abierta ? 'bi-chevron-down' : 'bi-chevron-right');
      }
    });
  };
  const conHijas = filas.filter(function (f) { return f.querySelector('.ou-plegar'); });
  conHijas.forEach(function (f) {
    f.querySelector('.ou-plegar').addEventListener('click', function () {
      if (cerradas.has(f.dataset.dn)) cerradas.delete(f.dataset.dn); else cerradas.add(f.dataset.dn);
      mostrar();
    });
  });
  const abrirHasta = function (f) { for (let p = porDn[f.dataset.padre]; p; p = porDn[p.dataset.padre]) cerradas.delete(p.dataset.dn); };
  document.getElementById('ou_abrir').addEventListener('click', function () { cerradas.clear(); mostrar(); });
  document.getElementById('ou_cerrar').addEventListener('click', function () { conHijas.forEach(function (f) { cerradas.add(f.dataset.dn); }); mostrar(); });
  if (filtro) filtro.addEventListener('input', mostrar);
  // Al entrar: todo contraido, salvo el camino hasta lo ya elegido.
  conHijas.forEach(function (f) { cerradas.add(f.dataset.dn); });
  filas.forEach(function (f) { if (caja(f).dataset.propio === '1') abrirHasta(f); });
  mostrar();
  // Detectar: lee con la cuenta de escritura donde tiene control delegado y marca las de arriba.
  const aviso = document.getElementById('ou_aviso');
  const decir = function (tipo, txt) { aviso.className = 'alert small py-2 mb-2 alert-' + tipo; aviso.textContent = txt; aviso.hidden = false; };
  const boton = document.getElementById('ou_detectar');
  boton.addEventListener('click', function () {
    boton.disabled = true;
    decir('secondary', 'Consultando al controlador de dominio con la cuenta de escritura…');
    const datos = new URLSearchParams();
    datos.set('_csrf', form.querySelector('input[name=_csrf]').value);
    datos.set('ad_write_user', form.querySelector('#ad_write_user').value);
    datos.set('ad_write_password', form.querySelector('#ad_write_password').value);
    fetch('/ad/configuracion/escritura/detectar', { method: 'POST', body: datos, credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json().catch(function () { return { error: 'Respuesta inesperada del servidor (' + r.status + ').' }; }); })
      .then(function (j) {
        if (j.error) { decir('danger', j.error); return; }
        const deleg = new Set(j.ous.map(function (o) { return o.dn.toLowerCase(); }));
        filas.forEach(function (f) {
          const m = f.querySelector('.ou-marca');
          m.innerHTML = deleg.has(f.dataset.dn) ? '<span class="badge text-bg-success">delegada</span>' : '';
        });
        if (!deleg.size) { decir('warning', 'La cuenta ' + j.account + ' no tiene control delegado en ninguna unidad organizativa. Delegue con scripts/windows/ad-cuenta-servicio.ps1 (opción 2).'); return; }
        // Las de arriba: delegadas cuyo padre no lo esta (sin la de controladores de dominio).
        marcar(function (f) { return deleg.has(f.dataset.dn) && !deleg.has(f.dataset.padre) && !esDc(f); });
        filas.forEach(function (f) { if (caja(f).dataset.propio === '1') abrirHasta(f); });
        mostrar();
        const arriba = filas.filter(function (f) { return caja(f).dataset.propio === '1'; }).length;
        const fuera = j.ous.filter(function (o) { return !porDn[o.dn.toLowerCase()]; }).length;
        decir('success', 'La cuenta ' + j.account + ' tiene control delegado en ' + deleg.size + ' unidad(es); se marcaron ' + arriba
          + ' (cada una incluye sus sub-unidades).' + (fuera ? ' ' + fuera + ' no aparecen en la lista: lea el dominio de nuevo.' : '') + ' Revise y guarde.');
      })
      .catch(function () { decir('danger', 'No se pudo consultar. Revise la conexión e intente de nuevo.'); })
      .finally(function () { boton.disabled = false; });
  });
  pintar();
})();
</script>
<%- include('../partials/foot') %>
