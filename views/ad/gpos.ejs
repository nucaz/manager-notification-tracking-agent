<%- include('../partials/head', { title: title }) %>
<%- include('_tabs') %>
<% const kindBadges = function (g) { return g.kinds.map(function (k) { const K = KINDS[k] || KINDS.otro;
     return '<span class="badge text-bg-' + K[2] + ' fw-normal me-1"><i class="bi ' + K[1] + '"></i> ' + K[0] + '</span>'; }).join(''); }; %>
<div class="card p-3">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <p class="small text-muted mb-2"><%= total %> directivas de grupo. Se lee del dominio qué existe, qué <strong>tipo</strong> de configuración trae cada una, dónde está vinculada y con qué
      precedencia. El detalle de cada ajuste (qué script, qué valor) está en la carpeta SYSVOL del dominio y no se lee desde aquí. Solo lectura.</p>
    <a href="/ad/gpo/aplicacion" class="btn btn-sm btn-primary"><i class="bi bi-diagram-3"></i> Dónde aplican</a>
  </div>
  <div class="d-flex flex-wrap gap-2 mb-2 small" id="gpo_filtros">
    <% Object.keys(FILTROS).forEach(function (k) { const n = ({ sin_vincular: gpoOv.unlinked, vacias: gpoOv.empty, deshabilitadas: gpoOv.disabled, scripts: gpoOv.scripts,
         software: gpoOv.software, restricciones: gpoOv.restrictions })[k]; %>
      <a class="btn btn-sm <%= keep.f === k ? 'btn-secondary' : 'btn-outline-secondary' %>" href="/ad/gpo?f=<%= k %>"><%= FILTROS[k][0].split(' (')[0] %><%= n === undefined ? '' : ' · ' + n %></a>
    <% }); %>
  </div>
  <%- include('_buscar', { placeholder: 'Directiva, unidad, tipo de configuración, software…' }) %>
  <div class="table-responsive">
    <table class="table table-hover table-sm align-middle small">
      <thead><tr><th>Directiva</th><th>Estado</th><th>Vinculada en</th><th>Qué trae</th><th>Por revisar</th><th>Modificada</th>
        <th data-oculta>Versión (equipo / usuario)</th><th data-oculta>Filtro WMI</th><th data-oculta>Software</th><th data-oculta>GUID</th></tr></thead>
      <tbody>
        <% items.forEach(function (g) { %>
          <tr>
            <td><a href="/ad/gpo/<%= g.gpo_guid %>"><%= g.name %></a></td>
            <td><span class="<%= g.status === 'Deshabilitada' ? 'text-danger fw-semibold' : '' %>"><%= g.status %></span></td>
            <td><% if (!g.links.length) { %><span class="text-warning-emphasis fw-semibold">Sin vincular</span><% } %>
              <% g.links.forEach(function (l, i) { %><%= i ? ', ' : '' %><span class="<%= l.link_enabled ? '' : 'text-decoration-line-through text-muted' %>" title="<%= l.target_dn %>"><%= l.target_name %></span><% if (l.enforced) { %>
                <span class="badge text-bg-dark fw-normal">exigido</span><% } %><% }); %></td>
            <td><%- kindBadges(g) || '<span class="text-muted">—</span>' %></td>
            <td class="<%= g.notes.length ? 'text-warning-emphasis' : 'text-muted' %>"><%= g.notes.join(' ') || '—' %></td>
            <td class="text-nowrap" data-valor="<%= g.when_changed || '' %>"><%= g.when_changed ? String(g.when_changed).slice(0, 10) : '—' %></td>
            <td style="font-variant-numeric: tabular-nums"><%= g.computer_version %> / <%= g.user_version %></td>
            <td><%= g.wmi_filter || '—' %></td>
            <td><%= g.software.map(function (s) { return s.name; }).join(', ') || '—' %></td>
            <td class="font-monospace"><%= g.gpo_guid %></td>
          </tr>
        <% }); %>
        <% if (!items.length) { %><tr><td colspan="10" class="text-center text-muted py-4"><%= total ? 'Ninguna directiva coincide.' : 'Sin directivas: lea el dominio.' %></td></tr><% } %>
      </tbody>
    </table>
  </div>
  <% if (orphans.length) { %>
    <div class="alert alert-warning small mt-2 mb-0"><i class="bi bi-exclamation-triangle"></i> <strong><%= orphans.length %> vínculo(s) apuntan a una directiva que ya no existe</strong>
      (se borró la GPO pero quedó el vínculo): <%= orphans.map(function (o) { return o.target_name + ' → {' + o.gpo_guid + '}'; }).join('; ') %>.</div>
  <% } %>
</div>
<%- include('../partials/foot') %>
