<%- include('../partials/head', { title: title }) %>
<%- include('_tabs') %>
<div class="card p-3">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <p class="small text-muted mb-2"><%= items.length %> grupos. Los privilegiados (por SID) van primero, con sus miembros efectivos incluidos los anidados.</p>
    <% if (canChange && writes.ready) { %><a href="/ad/cambios/nuevo?op=group_create" class="btn btn-sm btn-primary"><i class="bi bi-people"></i> Nuevo grupo</a><% } %>
  </div>
  <%- include('_buscar', { placeholder: 'Grupo, descripción, ubicación…' }) %>
  <div class="table-responsive">
    <table class="table table-hover table-sm align-middle small">
      <thead><tr><th>Grupo</th><th>Privilegiado</th><th>Tipo</th><th>Ámbito</th><th class="text-end">Miembros directos</th><th class="text-end">Usuarios efectivos</th>
        <th data-oculta>Descripción</th><th data-oculta>SID</th><th data-oculta>Ubicación</th></tr></thead>
      <tbody>
        <% items.forEach(function (g) { %>
          <tr>
            <td><a href="/ad/grupos/<%= g.id %>"><%= g.name %></a></td>
            <td><% if (g.privileged) { %><span class="badge text-bg-danger"><%= PRIVILEGED_LABEL[g.privileged] %></span><% } else { %>No<% } %></td>
            <td><%= g.kind === 'seguridad' ? 'Seguridad' : 'Distribución' %></td>
            <td><%= ({ global: 'Global', local: 'Dominio local', universal: 'Universal' })[g.scope] || '—' %></td>
            <td class="text-end"><%= g.member_count %></td>
            <td class="text-end"><%= g.privileged ? g.effective_users : '—' %></td>
            <td><%= g.description || '—' %></td>
            <td class="font-monospace"><%= g.sid || '—' %></td>
            <td class="font-monospace"><%= g.ou_dn || '—' %></td>
          </tr>
        <% }); %>
        <% if (!items.length) { %><tr><td colspan="9" class="text-center text-muted py-4">Sin grupos: lea el dominio.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/foot') %>
