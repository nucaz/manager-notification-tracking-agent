<%- include('../partials/head', { title: title }) %>
<%
  function url(params) {
    const p = new URLSearchParams(Object.assign({ tipo: tipo, q: q, por: por === 20 ? '' : String(por), orden: orden, dir: orden ? dir : '' }, params));
    Array.from(p.keys()).forEach(function (k) { if (!p.get(k)) p.delete(k); });
    return '/glpi/inventario?' + p.toString();
  }
  // En pantalla: las columnas mas utiles; el Excel lleva todas.
  const visibles = ['name', 'state', 'type', 'manufacturer', 'model', 'os', 'os_version', 'processor', 'memory_type', 'memory', 'ip',
    'serial', 'otherserial', 'location', 'user', 'entity'];
  const columnas = type.columns.filter(function (c) { return visibles.includes(c.key); });
%>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h2 class="mb-0">Inventario GLPI</h2>
  <% if (!connectionError) { %>
    <a href="/glpi/inventario/exportar.xlsx?<%= url({ page: '', por: '' }).split('?')[1] %>" class="btn btn-outline-success">
      <i class="bi bi-file-earmark-excel"></i> Exportar <%= type.label.toLowerCase() %> a Excel
    </a>
  <% } %>
</div>

<ul class="nav nav-tabs mb-3">
  <% Object.keys(tipos).forEach(function(k) { %>
    <li class="nav-item">
      <a class="nav-link <%= k === tipo ? 'active' : '' %>" href="<%= url({ tipo: k, page: '', orden: '', dir: '' }) %>"><i class="bi <%= tipos[k].icon %>"></i> <%= tipos[k].label %></a>
    </li>
  <% }); %>
</ul>

<% if (connectionError) { %>
  <div class="alert alert-danger">
    No se pudo conectar con GLPI: <%= connectionError %>
    <div class="small mt-1">Revise la configuración de GLPI en <a href="/configuracion">Configuración</a> y use "Probar conexión con GLPI".</div>
  </div>
<% } else { %>
  <form class="row g-2 mb-3" method="get">
    <input type="hidden" name="tipo" value="<%= tipo %>">
    <% if (orden) { %><input type="hidden" name="orden" value="<%= orden %>"><input type="hidden" name="dir" value="<%= dir %>"><% } %>
    <div class="col-12 col-md-5">
      <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Buscar <%= type.label.toLowerCase() %> por nombre, serie o N.º de inventario..." aria-label="Buscar">
    </div>
    <div class="col-auto">
      <button class="btn btn-outline-secondary" type="submit">Buscar</button>
      <% if (q) { %><a class="btn btn-link" href="<%= url({ q: '', page: '' }) %>">Quitar búsqueda</a><% } %>
    </div>
    <div class="col-auto ms-auto d-flex align-items-center gap-2">
      <label class="small text-nowrap mb-0" for="por_pagina">Mostrar</label>
      <select name="por" id="por_pagina" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
        <% porPagina.forEach(function(n) { %><option value="<%= n %>" <%= por === n ? 'selected' : '' %>><%= n %></option><% }); %>
        <option value="todos" <%= por === 'todos' ? 'selected' : '' %>>Todos</option>
      </select>
      <span class="small text-nowrap">registros</span>
    </div>
  </form>

  <% if (extras && !extras.ok) { %>
    <div class="alert alert-warning">
      <strong>Sin sistema operativo, procesador, memoria ni IP.</strong>
      La API v2 de GLPI no entrega esos datos; la app los toma de la API clásica del mismo GLPI, que ahora no responde: <%= extras.message %>
      <div class="small mt-1"><%= extras.help %> El resto del inventario no se ve afectado.</div>
    </div>
  <% } %>

  <div class="card p-3">
    <p class="text-muted small mb-2"><%= type.label %> en GLPI<%= q ? ' que coinciden con "' + q + '"' : '' %>: <strong><%= total %></strong></p>
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle mb-0 <%= columnas.length > 10 ? 'small' : '' %>" data-tabla="servidor" data-param-pagina="page">
        <thead>
          <tr>
            <% columnas.forEach(function(c) { %><th class="text-nowrap" data-orden="<%= c.key %>"><%= c.label %></th><% }); %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(it) { %>
            <tr>
              <% columnas.forEach(function(c) { %>
                <td class="<%= c.key === 'name' ? 'fw-semibold' : '' %>"><%= it[c.key] || '—' %></td>
              <% }); %>
              <td class="text-end">
                <a href="/glpi/inventario/<%= tipo === 'computadoras' ? '' : tipo + '/' %><%= it.id %>" class="btn btn-sm btn-outline-secondary">Ver</a>
              </td>
            </tr>
          <% }); %>
          <% if (items.length === 0) { %>
            <tr><td colspan="<%= columnas.length + 1 %>" class="text-center text-muted py-4">No se encontraron <%= type.label.toLowerCase() %>.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <nav class="mt-3">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= url({ page: page - 1 }) %>">Anterior</a></li>
          <li class="page-item disabled"><span class="page-link">Página <%= page %> de <%= totalPages %> · <%= (page - 1) * por + 1 %>–<%= Math.min(page * por, total) %> de <%= total %></span></li>
          <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="<%= url({ page: page + 1 }) %>">Siguiente</a></li>
        </ul>
      </nav>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
