<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <a href="/glpi/inventario?tipo=<%= tipo %>" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> <%= type.label %></a>
    <h2 class="mb-0"><i class="bi <%= type.icon %>"></i> <%= title %></h2>
    <span class="text-muted small"><%= type.singular %> · ID GLPI <%= id %></span>
  </div>
</div>

<% if (connectionError) { %>
  <div class="alert alert-danger">
    No se pudo obtener la información desde GLPI: <%= connectionError %>
  </div>
<% } else { %>
  <div class="row g-3">
    <div class="col-md-5">
      <div class="card p-3 mb-3">
        <h5>Datos</h5>
        <table class="table table-sm mb-0">
          <% detail.fields.forEach(function(f) { %>
            <tr><th style="width: 170px;"><%= f.label %></th><td class="text-break"><%= f.value %></td></tr>
          <% }); %>
        </table>
      </div>

      <div class="card p-3">
        <h5><%= tipo === 'computadoras' ? 'Monitores, impresoras y otros conectados' : 'Conectado a' %></h5>
        <% if (!connections.length) { %>
          <p class="text-muted mb-0"><%= tipo === 'computadoras' ? 'GLPI no registra equipos conectados a esta computadora.' : 'GLPI no lo registra conectado a ninguna computadora.' %></p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% connections.forEach(function(c) { %>
              <li class="list-group-item px-0">
                <% if (c.typeKey) { %>
                  <a href="/glpi/inventario/<%= c.typeKey === 'computadoras' ? '' : c.typeKey + '/' %><%= c.id %>"><%= c.name %></a>
                  <span class="text-muted small">· <%= ({ computadoras: 'Computadora', monitores: 'Monitor', impresoras: 'Impresora' })[c.typeKey] %></span>
                <% } else { %>
                  <%= c.name %> <span class="text-muted small">· <%= c.itemtype %></span>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>

    <% if (software) { %>
    <div class="col-md-7">
      <div class="card p-3">
        <h5>Software instalado <span class="badge bg-primary"><%= software.total %></span></h5>
        <% if (software.truncated) { %>
          <p class="text-muted small">Mostrando los primeros <%= software.items.length %> de <%= software.total %>.</p>
        <% } %>
        <% if (software.items.length === 0) { %>
          <p class="text-muted mb-0">No se encontró software instalado registrado en GLPI para este equipo.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr><th>Software</th><th>Versión</th></tr></thead>
              <tbody>
                <% software.items.forEach(function(s) { %>
                  <tr><td><%= s.name %></td><td><%= s.version || '—' %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
