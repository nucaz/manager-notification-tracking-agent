<%- include('../partials/head', { title: title }) %>

<h2 class="mb-3"><%= title %></h2>

<form method="post" class="card p-4" action="<%= item.id ? '/celulares/chips/' + item.id + '/editar' : '/celulares/chips/nuevo' %>"
      <%- item.id ? 'onsubmit="return confirm(\'¿Guardar los cambios en este chip?' + (item.device_id ? ' Si es el número principal de su celular, el celular también se actualiza.' : '') + '\');"' : '' %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-md-3">
      <label class="form-label" for="phone_country_select">País</label>
      <% const defaultCountry = countries.find(function(c) { return c.calling_code === '51'; }); %>
      <% const selectedCountryId = item.phone_country_code_id || (defaultCountry ? defaultCountry.id : ''); %>
      <select name="phone_country_code_id" id="phone_country_select" class="form-select"
              onchange="var o=this.options[this.selectedIndex]; var len=o.getAttribute('data-length'); var n=document.getElementById('phone_number_input'); if (len) { n.maxLength = len; n.placeholder = len + ' dígitos'; }">
        <% countries.forEach(function(c) { %>
          <option value="<%= c.id %>" data-length="<%= c.mobile_length %>" <%= String(selectedCountryId) === String(c.id) ? 'selected' : '' %>>+<%= c.calling_code %> <%= c.country_name %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="phone_number_input">Número de línea *</label>
      <% const selectedCountry = countries.find(function(c) { return String(c.id) === String(selectedCountryId); }); %>
      <input type="text" name="phone_number" id="phone_number_input" class="form-control" required value="<%= item.phone_number || '' %>"
        inputmode="numeric" pattern="\d*" <%- selectedCountry ? 'maxlength="' + selectedCountry.mobile_length + '" placeholder="' + selectedCountry.mobile_length + ' dígitos"' : '' %>>
      <div class="form-text">Un chip siempre tiene número. Solo dígitos.</div>
    </div>
    <div class="col-md-5">
      <label class="form-label" for="iccid">ICCID (opcional)</label>
      <input type="text" name="iccid" id="iccid" class="form-control font-monospace" value="<%= item.iccid || '' %>"
        inputmode="numeric" pattern="\d{18,22}" maxlength="22" title="Entre 18 y 22 dígitos">
      <div class="form-text">El número impreso en el chip (19–20 dígitos). Sirve para identificarlo cuando no está en un equipo.</div>
    </div>

    <div class="col-md-4">
      <label class="form-label" for="operadora_select">Operadora</label>
      <% const operadoraEsOtro = item.operadora && !operadoras.includes(item.operadora); %>
      <select name="operadora" id="operadora_select" class="form-select" onchange="document.getElementById('operadora_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% operadoras.forEach(function(o) { %>
          <option value="<%= o %>" <%= item.operadora === o ? 'selected' : '' %>><%= o %></option>
        <% }); %>
        <option value="<%= operadoraEsOtro ? item.operadora : '__otro__' %>" <%= operadoraEsOtro ? 'selected' : '' %>><%= operadoraEsOtro ? item.operadora : 'Otro (especificar)...' %></option>
      </select>
      <input type="text" id="operadora_otro" class="form-control mt-2" placeholder="Especificar operadora..." maxlength="50" <%= operadoraEsOtro ? '' : 'hidden' %>
        value="<%= operadoraEsOtro ? item.operadora : '' %>"
        oninput="var o=document.querySelector('#operadora_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
    </div>
    <div class="col-md-4">
      <label class="form-label" for="plan">Plan</label>
      <input type="text" name="plan" id="plan" class="form-control" maxlength="60" value="<%= item.plan || '' %>" placeholder="Ej: Corporativo 29.90 ilimitado">
    </div>
    <div class="col-md-4">
      <label class="form-label" for="costo_plan">Costo mensual del plan (S/)</label>
      <input type="number" name="costo_plan" id="costo_plan" class="form-control" step="0.01" min="0" value="<%= item.costo_plan === null || item.costo_plan === undefined ? '' : item.costo_plan %>">
      <div class="form-text">Se suma en el listado de chips según los filtros.</div>
    </div>

    <div class="col-md-4">
      <label class="form-label" for="estado">Estado</label>
      <select name="estado" id="estado" class="form-select">
        <% Object.keys(mobileLabels.LINE_ESTADO).forEach(function(k) { %>
          <option value="<%= k %>" <%= (item.estado || 'activo') === k ? 'selected' : '' %>><%= mobileLabels.LINE_ESTADO[k].label %></option>
        <% }); %>
      </select>
      <div class="form-text">Suspendido: bloqueado por la operadora o por pérdida. De baja: el chip sale del celular y se cierra su asignación.</div>
    </div>
    <div class="col-md-8">
      <label class="form-label" for="notes">Notas</label>
      <textarea name="notes" id="notes" class="form-control" rows="2" maxlength="250"><%= item.notes || '' %></textarea>
    </div>
  </div>
  <div class="form-text mt-3">
    Dónde está el chip (en un celular, asignado a una persona o como número de emergencia) se define desde su detalle, después de guardarlo.
  </div>
  <div class="mt-3">
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="<%= item.id ? '/celulares/chips/' + item.id : '/celulares/chips' %>" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
