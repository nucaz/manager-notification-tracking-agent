<%- include('../partials/head', { title: title }) %>
<%
  // URL del listado con los filtros actuales + un cambio: asi las tarjetas
  // y los totales se "encadenan" (agregan un filtro sin perder los demas).
  function withFilter(key, value) {
    const p = new URLSearchParams();
    Object.keys(filters).forEach(function (k) { if (filters[k]) p.set(k, filters[k]); });
    if (value) p.set(key, value); else p.delete(key);
    const s = p.toString();
    return '/celulares/chips' + (s ? '?' + s : '');
  }
  function soles(n) { return 'S/ ' + Number(n || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  const U = mobileLabels.LINE_UBICACION;
%>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <a href="/celulares" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Celulares</a>
    <h2 class="mb-0">Chips <span class="text-muted fs-6">(<%= items.length %><%= activeFilters ? ' con filtros' : '' %>)</span></h2>
  </div>
  <div class="d-flex flex-wrap gap-1">
    <a href="/celulares/recibos" class="btn btn-outline-primary"><i class="bi bi-receipt"></i> Recibos</a>
    <a href="/celulares/chips/exportar.xlsx<%= filterQuery %>" class="btn btn-outline-success" title="Exporta los chips filtrados, con la fila de totales">
      <i class="bi bi-file-earmark-excel"></i> Exportar Excel
    </a>
    <% if (currentUser.role !== 'lector') { %>
      <a href="/celulares/chips/importar" class="btn btn-outline-secondary"><i class="bi bi-upload"></i> Importar Excel</a>
      <a href="/celulares/chips/escanear" class="btn btn-outline-primary"><i class="bi bi-upc-scan"></i> Ingresar por escaneo</a>
      <a href="/celulares/chips/uso" class="btn btn-outline-success" title="Cuánto se paga y se usa, y cuánto se paga y está guardado"><i class="bi bi-pie-chart"></i> Uso real</a>
      <a href="/celulares/chips/desde-notas" class="btn btn-outline-secondary" title="Números anotados en las notas de los celulares (ej. &quot;N° 2 uso WhatsApp&quot;), para registrarlos como 2.º chip"><i class="bi bi-sim"></i> 2.º chip desde notas</a>
      <a href="/celulares/chips/nuevo" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo chip</a>
    <% } %>
  </div>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-12 col-md-3">
    <input type="text" name="q" value="<%= filters.q %>" class="form-control" placeholder="Número, ICCID, usuario, IMEI, código o plan...">
  </div>
  <div class="col-6 col-md-2">
    <select name="ubicacion" class="form-select" aria-label="Ubicación">
      <option value="">Toda ubicación</option>
      <% Object.keys(U).forEach(function(k) { %>
        <option value="<%= k %>" <%= filters.ubicacion === k ? 'selected' : '' %>><%= U[k].label %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-6 col-md-2">
    <select name="estado" class="form-select" aria-label="Estado">
      <option value="">Todo estado</option>
      <% Object.keys(mobileLabels.LINE_ESTADO).forEach(function(k) { %>
        <option value="<%= k %>" <%= filters.estado === k ? 'selected' : '' %>><%= mobileLabels.LINE_ESTADO[k].label %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-6 col-md-2">
    <select name="operadora" class="form-select" aria-label="Operadora">
      <option value="">Toda operadora</option>
      <% operadoras.forEach(function(o) { %>
        <option value="<%= o %>" <%= filters.operadora === o ? 'selected' : '' %>><%= o %></option>
      <% }); %>
      <option value="__sin__" <%= filters.operadora === '__sin__' ? 'selected' : '' %>>Sin operadora</option>
    </select>
  </div>
  <div class="col-6 col-md-3">
    <select name="costo" class="form-select" aria-label="Costo del plan">
      <option value="">Con y sin costo registrado</option>
      <option value="con" <%= filters.costo === 'con' ? 'selected' : '' %>>Solo con costo registrado</option>
      <option value="sin" <%= filters.costo === 'sin' ? 'selected' : '' %>>Solo sin costo (por completar)</option>
    </select>
  </div>
  <div class="col-6 col-md-3">
    <select name="area" class="form-select" aria-label="Área">
      <option value="">Todas las áreas</option>
      <% areas.forEach(function(a) { %>
        <option value="<%= a %>" <%= filters.area === a ? 'selected' : '' %>><%= a %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-6 col-md-3">
    <select name="sede" class="form-select" aria-label="Sede">
      <option value="">Todas las sedes</option>
      <% sedes.forEach(function(s) { %>
        <option value="<%= s %>" <%= filters.sede === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i> Filtrar</button>
    <% if (activeFilters) { %><a href="/celulares/chips" class="btn btn-link">Quitar filtros</a><% } %>
  </div>
</form>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3">
    <div class="card p-3 h-100">
      <div class="text-muted small">Chips<%= activeFilters ? ' (filtrados)' : '' %></div>
      <div class="fs-3 fw-semibold" style="font-variant-numeric: tabular-nums;"><%= summary.total %></div>
      <div class="small text-muted"><%= summary.porEstado.activo %> activos · <%= summary.porEstado.suspendido %> suspendidos ·
        <% if (summary.porEstado.de_baja) { %><a href="<%= withFilter('estado', 'de_baja') %>"><%= summary.porEstado.de_baja %> de baja</a><% } else { %>0 de baja<% } %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card p-3 h-100" style="font-variant-numeric: tabular-nums;">
      <div class="text-muted small">Se paga al mes (con descuento)</div>
      <div class="fs-3 fw-semibold"><%= soles(summary.netoTotal) %></div>
      <div class="small">
        Sin descuento: <strong><%= soles(summary.costoTotal) %></strong>
        <% if (summary.descuentoTotal) { %><span class="text-muted">· ahorro <%= soles(summary.descuentoTotal) %> en <%= summary.conDescuento %> chip(s)</span><% } %>
      </div>
      <div class="small">
        <%= summary.conCosto %> con costo ·
        <% if (summary.sinCosto) { %><a href="<%= withFilter('costo', 'sin') %>"><%= summary.sinCosto %> sin costo registrado</a><% } else { %>0 sin costo<% } %>
      </div>
      <% if (summary.porEstado.de_baja) { %>
        <div class="small text-muted">Los <%= summary.porEstado.de_baja %> de baja no se suman<%= summary.ahorroBajas ? ' (costaban ' + soles(summary.ahorroBajas) + ')' : '' %>.</div>
      <% } %>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card p-3 h-100">
      <div class="text-muted small mb-1">Dónde están (clic para agregar el filtro)</div>
      <div class="d-flex flex-wrap gap-2">
        <% Object.keys(U).forEach(function(k) { %>
          <a class="btn btn-sm <%= filters.ubicacion === k ? 'btn-dark' : 'btn-outline-secondary' %>" href="<%= withFilter('ubicacion', filters.ubicacion === k ? '' : k) %>">
            <%= U[k].label %> <span class="badge <%= U[k].badge %> ms-1"><%= summary.porUbicacion[k] || 0 %></span>
          </a>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<% const ops = Object.keys(summary.porOperadora).sort(); %>
<% if (ops.length) { %>
<div class="card p-3 mb-3">
  <div class="text-muted small mb-1">Por operadora</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0" style="max-width: 46rem; font-variant-numeric: tabular-nums;">
      <thead><tr><th>Operadora</th><th class="text-end">Chips</th><th class="text-end">Sin descuento</th><th class="text-end">Con descuento</th></tr></thead>
      <tbody>
        <% ops.forEach(function(o) { %>
          <tr>
            <td><a href="<%= withFilter('operadora', o === 'Sin operadora' ? '__sin__' : o) %>"><%= o %></a></td>
            <td class="text-end"><%= summary.porOperadora[o].cantidad %></td>
            <td class="text-end"><%= soles(summary.porOperadora[o].costo) %></td>
            <td class="text-end"><%= soles(summary.porOperadora[o].neto) %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot><tr class="fw-semibold"><td>Total</td><td class="text-end"><%= summary.total %></td><td class="text-end"><%= soles(summary.costoTotal) %></td><td class="text-end"><%= soles(summary.netoTotal) %></td></tr></tfoot>
    </table>
  </div>
</div>
<% } %>

<% const canMark = currentUser.role !== 'lector' && items.length > 0; %>
<div class="card p-3">
  <% if (canMark) { %>
    <form action="/celulares/chips/operadora" method="post" class="row g-2 align-items-center mb-3" id="op_masiva"
          onsubmit="var c = document.querySelectorAll('.chip-mark:checked'); if (!c.length) { alert('Marque al menos un chip.'); return false; } if (!this.operadora.value) { alert('Elija la operadora.'); return false; } this.ids.value = Array.prototype.map.call(c, function (x) { return x.value; }).join(','); return confirm('Se asignará la operadora ' + this.operadora.value + ' a ' + c.length + ' chip(s). ¿Continuar?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="ids" value="">
      <input type="hidden" name="back" value="<%= filterQuery %>">
      <div class="col-auto"><span class="fw-semibold"><span id="marcados">0</span> marcado(s)</span></div>
      <div class="col-auto">
        <select name="operadora" class="form-select form-select-sm" aria-label="Operadora a asignar">
          <option value="">Operadora a asignar…</option>
          <% catalogOperadoras.forEach(function(o) { %><option value="<%= o %>"><%= o %></option><% }); %>
        </select>
      </div>
      <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit">Asignar a los marcados</button></div>
      <div class="col-auto small text-muted">
        Marque uno, varios o todos los que se ven (para marcar más a la vez, elija "Todos" en "Mostrar … registros").
        <% if (filters.operadora !== '__sin__') { %><a href="<%= withFilter('operadora', '__sin__') %>">Ver solo los que no tienen operadora</a><% } %>
      </div>
    </form>
  <% } %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <% if (canMark) { %><th style="width: 2rem;"><input type="checkbox" class="form-check-input" id="mark_all" aria-label="Marcar todos"
            onchange="var on = this.checked; Array.prototype.forEach.call(document.querySelectorAll('tr:not([hidden]) .chip-mark'), function (x) { x.checked = on; }); document.getElementById('marcados').textContent = document.querySelectorAll('.chip-mark:checked').length;"></th><% } %>
          <th>Número</th><th>Operadora</th><th>Plan</th><th class="text-end">Sin descuento</th><th class="text-end">Con descuento</th><th>Estado</th><th>Ubicación</th>
          <th>Usuario</th><th>Área</th><th>Sede</th><th>Celular</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(it) { %>
          <tr>
            <% if (canMark) { %><td><input type="checkbox" class="form-check-input chip-mark" value="<%= it.id %>" aria-label="Marcar <%= it.phone_number %>"
              onchange="document.getElementById('marcados').textContent = document.querySelectorAll('.chip-mark:checked').length;"></td><% } %>
            <td class="text-nowrap"><a href="/celulares/chips/<%= it.id %>"><%= it.calling_code ? '+' + it.calling_code + ' ' : '' %><%= it.phone_number %></a>
              <% if (it.iccid) { %><div class="small text-muted font-monospace">ICCID <%= it.iccid %></div><% } %></td>
            <td><%= it.operadora || '—' %></td>
            <td><%= it.plan || '—' %></td>
            <td class="text-end text-nowrap" style="font-variant-numeric: tabular-nums;"><%= it.costo_plan === null ? '—' : soles(it.costo_plan) %></td>
            <td class="text-end text-nowrap" style="font-variant-numeric: tabular-nums;" title="<%= it.descuento_nota || '' %>"><%= it.costo_plan === null ? '—' : soles(Number(it.costo_plan) - (Number(it.descuento_plan) || 0)) %></td>
            <td><span class="badge <%= mobileLabels.lineEstado(it.estado).badge %>"><%= mobileLabels.lineEstado(it.estado).label %></span>
              <% if (it.estado === 'de_baja' && it.fecha_baja) { %><div class="small text-muted text-nowrap" title="<%= it.motivo_baja || '' %>">desde <%= it.fecha_baja %></div><% } %></td>
            <td><span class="badge <%= mobileLabels.lineUbicacion(it.ubicacion).badge %>"><%= mobileLabels.lineUbicacion(it.ubicacion).label %></span></td>
            <td><%= it.holder || '—' %></td>
            <td><%= it.area || '—' %></td>
            <td><%= it.sede || '—' %></td>
            <td class="text-nowrap"><% if (it.device_id) { %><a href="/celulares/<%= it.device_id %>"><%= it.asset_code || it.imei %></a><% if (!it.es_principal) { %> <span class="small text-muted">(2.º chip)</span><% } %><% } else { %>—<% } %></td>
            <td class="text-end"><a href="/celulares/chips/<%= it.id %>" class="btn btn-sm btn-outline-secondary">Ver</a></td>
          </tr>
        <% }); %>
        <% if (items.length === 0) { %>
          <tr><td colspan="13" class="text-center text-muted py-4"><%= activeFilters ? 'Ningún chip cumple estos filtros.' : 'No hay chips registrados.' %></td></tr>
        <% } %>
      </tbody>
      <% if (items.length) { %>
        <tfoot>
          <tr class="fw-semibold" style="font-variant-numeric: tabular-nums;">
            <%# Una celda por columna (sin combinar): asi las columnas se pueden mover. %>
            <% if (canMark) { %><td></td><% } %>
            <td class="text-nowrap"><%= summary.total %> chip(s)</td><td></td><td></td>
            <td class="text-end text-nowrap"><%= soles(summary.costoTotal) %></td>
            <td class="text-end text-nowrap"><%= soles(summary.netoTotal) %></td>
            <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
          </tr>
        </tfoot>
      <% } %>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
