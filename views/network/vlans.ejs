<%- include('../partials/head', { title: title }) %>
<% const puede = currentUser.role !== 'lector';
   const e = edit || {};
   const v = function (k) { return e[k] === null || e[k] === undefined ? '' : e[k]; }; %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="mb-0">Red — VLAN</h2></div>
<%- include('_tabs') %>
<div class="row g-3">
  <div class="<%= puede ? 'col-lg-8' : 'col-12' %>">
    <div class="card p-3">
      <p class="small text-muted mb-2"><%= items.length %> VLAN registradas. Cada equipo indica cuáles tiene (en su ficha).</p>
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle small">
          <thead><tr><th>VLAN</th><th>Nombre</th><th>Subred</th><th>Puerta de enlace</th><th>Sede</th><th class="text-end">Equipos</th><th data-oculta>Notas</th>
            <% if (puede) { %><th data-orden="no"></th><% } %></tr></thead>
          <tbody>
            <% items.forEach(function (x) { %>
              <tr class="<%= edit && edit.id === x.id ? 'table-active' : '' %>">
                <td class="fw-semibold" style="font-variant-numeric: tabular-nums"><%= x.vlan_number %></td>
                <td><%= x.name %></td>
                <td class="font-monospace"><%= x.subnet || '—' %></td>
                <td class="font-monospace"><%= x.gateway || '—' %></td>
                <td><%= x.sede || 'Todas' %></td>
                <td class="text-end"><%= x.devices_count %></td>
                <td><%= x.notes || '—' %></td>
                <% if (puede) { %><td class="text-nowrap text-end">
                  <a class="btn btn-sm btn-outline-primary" href="/red/vlan?editar=<%= x.id %>" title="Editar"><i class="bi bi-pencil"></i></a>
                  <form method="post" action="/red/vlan/<%= x.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar la VLAN <%= x.vlan_number %>? Los equipos que la tienen quedan sin ella.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button></form>
                </td><% } %>
              </tr>
            <% }); %>
            <% if (!items.length) { %><tr><td colspan="<%= puede ? 8 : 7 %>" class="text-center text-muted py-4">Sin VLAN registradas.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% if (puede) { %>
  <div class="col-lg-4">
    <form method="post" action="/red/vlan" class="card p-3" autocomplete="off" id="vlan_form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
      <h6><%= edit ? 'Editar VLAN ' + edit.vlan_number : 'Nueva VLAN' %></h6>
      <div class="row g-2">
        <div class="col-4"><label class="form-label small" for="vlan_number">Número *</label>
          <input class="form-control form-control-sm" id="vlan_number" name="vlan_number" type="number" min="1" max="4094" required value="<%= v('vlan_number') %>"></div>
        <div class="col-8"><label class="form-label small" for="vlan_name">Nombre *</label>
          <input class="form-control form-control-sm" id="vlan_name" name="name" required maxlength="100" value="<%= v('name') %>" placeholder="Administración, Wi-Fi invitados…"></div>
        <div class="col-6"><label class="form-label small" for="subnet">Subred</label>
          <input class="form-control form-control-sm font-monospace" id="subnet" name="subnet" maxlength="18" value="<%= v('subnet') %>" placeholder="172.16.10.0/24"></div>
        <div class="col-6"><label class="form-label small" for="gateway">Puerta de enlace</label>
          <input class="form-control form-control-sm font-monospace" id="gateway" name="gateway" maxlength="15" value="<%= v('gateway') %>" placeholder="172.16.10.1"></div>
        <div class="col-12"><label class="form-label small" for="vlan_sede">Sede (vacío = todas)</label>
          <input class="form-control form-control-sm" id="vlan_sede" name="sede" maxlength="100" list="vlan_sedes" value="<%= v('sede') %>">
          <datalist id="vlan_sedes"><% sedes.forEach(function (s) { %><option value="<%= s %>"><% }); %></datalist></div>
        <div class="col-12"><label class="form-label small" for="vlan_notes">Notas</label>
          <textarea class="form-control form-control-sm" id="vlan_notes" name="notes" rows="2" maxlength="500"><%= v('notes') %></textarea></div>
      </div>
      <div class="mt-3 d-flex gap-2"><button class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
        <% if (edit) { %><a href="/red/vlan" class="btn btn-sm btn-outline-secondary">Cancelar</a><% } %></div>
    </form>
  </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
