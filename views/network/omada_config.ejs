<%- include('../partials/head', { title: title }) %>
<%- include('_omada_nav') %>
<% const f = draft || edit || {};
   const v = function (k, def) { return f[k] === null || f[k] === undefined ? (def || '') : f[k]; };
   const off = function (k) { return String(v(k, '1')) === '0'; }; %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card p-3">
      <h6>Controladores</h6>
      <div class="table-responsive">
        <table class="table table-sm align-middle small">
          <thead><tr><th>Nombre</th><th>Interfaz</th><th class="text-end">Sitios</th><th>Última lectura</th><th data-orden="no"></th></tr></thead>
          <tbody>
            <% controllers.forEach(function (c) { %>
              <tr class="<%= edit && edit.id === c.id ? 'table-active' : '' %>">
                <td class="fw-semibold"><%= c.name %><% if (!c.enabled) { %> <span class="badge text-bg-secondary">en pausa</span><% } %>
                  <div><span class="badge text-bg-<%= c.allow_actions ? 'warning' : 'light border' %> fw-normal"><%= c.allow_actions ? 'Lectura y acciones' : 'Solo lectura' %></span></div></td>
                <td class="font-monospace"><%= c.base_url.replace('https://', '') %></td>
                <td class="text-end"><%= c.sites %></td>
                <td><% if (c.last_sync_at) { %><span class="badge text-bg-<%= c.last_sync_ok ? 'success' : 'danger' %>"><%= c.last_sync_ok ? 'Correcta' : 'Falló' %></span> <%= String(c.last_sync_at).slice(0, 16) %>
                  <div class="text-muted"><%= c.last_sync_detail %></div><% } else { %>Aún no se ha leído<% } %></td>
                <td class="text-nowrap text-end">
                  <form method="post" action="/red/omada/configuracion/<%= c.id %>/probar" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-outline-secondary" title="Probar la conexión"><i class="bi bi-plug"></i></button></form>
                  <a class="btn btn-sm btn-outline-primary" href="/red/omada/configuracion?editar=<%= c.id %>" title="Editar"><i class="bi bi-pencil"></i></a>
                  <form method="post" action="/red/omada/configuracion/<%= c.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Quitar este controlador y todo lo que se leyó de él? En Omada no se cambia nada.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" title="Quitar"><i class="bi bi-trash"></i></button></form>
                </td>
              </tr>
            <% }); %>
            <% if (!controllers.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Sin controladores.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card p-3 mt-3 small">
      <h6>Dónde se obtiene cada dato</h6>
      <ol class="mb-2 ps-3">
        <li>Entre al controlador (desde la nube de Omada, pulse el icono del globo del OC300) y vaya a la vista <strong>Global</strong> → <strong>Settings</strong> → <strong>Platform Integration</strong> → <strong>Open API</strong>.</li>
        <li>Con <strong>Add New App</strong> cree una aplicación en modo <strong>Client</strong>, con rol <strong>Viewer</strong> y acceso a los sitios que quiera ver.</li>
        <li>Pulse el icono del ojo de la aplicación: ahí están el <strong>Client ID</strong>, el <strong>Client Secret</strong>, el <strong>Omada ID</strong> y la <strong>dirección de la interfaz</strong> (Interface Access Address).</li>
        <li>Si no ve el Omada ID ahí: es el valor que sigue a <code>omadacId=</code> en la barra de direcciones del navegador cuando tiene abierto ese controlador. Puede pegar la dirección completa en el campo y se toma solo ese valor.</li>
        <li>Dirección de la interfaz para un controlador que se abre desde <code>use1-omada-cloud.tplinkcloud.com</code>: <code>https://use1-omada-northbound.tplinkcloud.com</code> (en otras regiones cambia el prefijo: <code>euw1</code>, <code>aps1</code>).</li>
      </ol>
      <p class="mb-1"><strong>Cada OC300 es un controlador distinto</strong>: tiene su propio Omada ID y necesita su propia aplicación Open API. Si tiene dos (por ejemplo, Pueblo Libre y Surco), agregue dos controladores aquí.</p>
      <p class="mb-1">Aquí los dos se ven juntos: el resumen, los equipos y los clientes muestran todos los sitios, o uno solo con el selector.</p>
      <p class="mb-0 text-muted">Por defecto solo se lee (equipos, clientes y consumo). Para <strong>bloquear, desbloquear o reconectar clientes</strong> desde aquí hacen falta dos cosas: marcar «Permitir acciones» en el controlador y que su aplicación Open API tenga rol <strong>Admin</strong> (con Viewer, Omada rechaza la acción). El Client Secret se guarda cifrado y no se vuelve a mostrar.</p>
    </div>
  </div>
  <div class="col-lg-5">
    <form method="post" action="/red/omada/configuracion" class="card p-3" autocomplete="off" id="omada_form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
      <h6><%= edit ? 'Editar ' + edit.name : 'Nuevo controlador' %></h6>
      <div class="mb-3 p-2 border rounded bg-body-tertiary">
        <label class="form-label small mb-1" for="o_pegar"><i class="bi bi-magic"></i> Extraer el Omada ID de la dirección del controlador</label>
        <div class="input-group input-group-sm">
          <input class="form-control font-monospace" id="o_pegar" type="text" autocomplete="off" spellcheck="false" placeholder="Pegue aquí la dirección completa del navegador (https://…omadacId=…)">
          <button class="btn btn-outline-primary" type="button" id="o_extraer">Extraer</button>
        </div>
        <div class="form-text" id="o_pegar_msg" aria-live="polite">Abra el controlador desde la nube de Omada, copie la dirección de la barra del navegador y péguela. Se llenan el Omada ID y la dirección de la interfaz; lo pegado no se envía ni se guarda.</div>
      </div>
      <div class="mb-2"><label class="form-label small" for="o_name">Nombre *</label>
        <input class="form-control form-control-sm" id="o_name" name="name" value="<%= v('name') %>" maxlength="100" required placeholder="OC300 Pueblo Libre"></div>
      <div class="mb-2"><label class="form-label small" for="o_url">Dirección de la interfaz *</label>
        <input class="form-control form-control-sm font-monospace" id="o_url" name="base_url" value="<%= v('base_url') %>" maxlength="255" required placeholder="https://use1-omada-northbound.tplinkcloud.com">
        <div class="form-text">Tal como aparece en «Interface Access Address». Para un controlador local: https://IP:puerto.</div></div>
      <div class="mb-2"><label class="form-label small" for="o_cid">Omada ID *</label>
        <input class="form-control form-control-sm font-monospace" id="o_cid" name="omadac_id" value="<%= String(v('omadac_id')).slice(0, 64) %>" maxlength="600" required>
        <div class="form-text">El valor de <code>omadacId=</code> en la dirección del navegador con el controlador abierto (32 letras y números). Es distinto en cada OC300.</div></div>
      <div class="mb-2"><label class="form-label small" for="o_client">Client ID *</label>
        <input class="form-control form-control-sm font-monospace" id="o_client" name="client_id" value="<%= v('client_id') %>" maxlength="64" required></div>
      <div class="mb-2"><label class="form-label small" for="o_secret">Client Secret <%= edit ? '' : '*' %></label>
        <input type="password" class="form-control form-control-sm font-monospace" id="o_secret" name="client_secret" maxlength="200" autocomplete="new-password" <%= edit ? '' : 'required' %>
          placeholder="<%= edit ? 'Guardado. Escriba uno solo para cambiarlo.' : '' %>"></div>
      <div class="form-check mb-1"><input type="hidden" name="verify_tls" value="0"><input class="form-check-input" type="checkbox" id="o_tls" name="verify_tls" value="1" <%= off('verify_tls') ? '' : 'checked' %>>
        <label class="form-check-label small" for="o_tls">Verificar certificado <span class="text-muted">(desmarque solo para un controlador local con certificado propio)</span></label></div>
      <div class="form-check mb-1"><input type="hidden" name="enabled" value="0"><input class="form-check-input" type="checkbox" id="o_on" name="enabled" value="1" <%= off('enabled') ? '' : 'checked' %>>
        <label class="form-check-label small" for="o_on">Leer este controlador cada 5 minutos</label></div>
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="o_act" name="allow_actions" value="1" <%= String(v('allow_actions', '0')) === '1' ? 'checked' : '' %>>
        <label class="form-check-label small" for="o_act">Permitir acciones: bloquear, desbloquear y reconectar clientes <span class="text-muted">(solo administradores; requiere rol Admin en la aplicación Open API)</span></label></div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg"></i> Guardar y probar</button>
        <% if (edit) { %><a class="btn btn-outline-secondary btn-sm" href="/red/omada/configuracion">Cancelar</a><% } %>
      </div>
    </form>
  </div>
</div>
<script>
  // Extrae el Omada ID (omadacId=) de la direccion pegada y propone la direccion
  // de la interfaz de la misma region. Todo ocurre en el navegador: el campo no
  // tiene "name", asi que la direccion (que trae un token de sesion) no se envia.
  (function () {
    var box = document.getElementById('o_pegar');
    var msg = document.getElementById('o_pegar_msg');
    var id = document.getElementById('o_cid');
    var url = document.getElementById('o_url');
    function extraer() {
      var text = box.value.trim();
      if (!text) return;
      var m = /[?&#]omadacId=([A-Za-z0-9]{8,64})/.exec(text);
      box.value = '';
      if (!m) {
        msg.className = 'form-text text-danger';
        msg.textContent = 'Esa dirección no trae omadacId=. Ábrala con el controlador ya cargado (después de pulsar el globo) y cópiela completa.';
        return;
      }
      id.value = m[1];
      var done = 'Omada ID extraído: ' + m[1] + '.';
      // use1-omada-cloud.tplinkcloud.com -> https://use1-omada-northbound.tplinkcloud.com
      var region = /^https:\/\/([a-z0-9]+)-omada-cloud\.tplinkcloud\.com(?:[/:?#]|$)/i.exec(text);
      if (region) {
        var proposed = 'https://' + region[1].toLowerCase() + '-omada-northbound.tplinkcloud.com';
        if (!url.value.trim() || /-omada-northbound\.tplinkcloud\.com$/i.test(url.value.trim())) {
          url.value = proposed;
          done += ' Dirección de la interfaz: ' + proposed + '.';
        }
      }
      msg.className = 'form-text text-success';
      msg.textContent = done + ' Faltan el Client ID y el Client Secret.';
      (document.getElementById('o_name').value ? document.getElementById('o_client') : document.getElementById('o_name')).focus();
    }
    document.getElementById('o_extraer').addEventListener('click', extraer);
    box.addEventListener('paste', function () { setTimeout(extraer, 0); });
    box.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); extraer(); } });
  })();
</script>
<%- include('../partials/foot') %>
