<%- include('../partials/head', { title: title }) %>
<%- include('_omada_nav') %>
<% const t = d.totals;
   const qs = function (extra) { const p = []; if (site) p.push('sitio=' + site.id); if (extra) p.push(extra); return p.length ? '?' + p.join('&') : ''; };
   // Grafico de lineas dibujado en el servidor (sin librerias): ancho 720, alto 200.
   const W = 720, H = 200, L = 62, R = 10, T = 10, B = 24;
   const chart = function (series, keys) {
     const max = Math.max(1, ...series.map(function (p) { return Math.max(...keys.map(function (k) { return p[k]; })); }));
     const x = function (i) { return L + (series.length > 1 ? i * (W - L - R) / (series.length - 1) : (W - L - R) / 2); };
     const y = function (v) { return T + (H - T - B) * (1 - v / max); };
     const line = function (k) { return series.map(function (p, i) { return x(i).toFixed(1) + ',' + y(p[k]).toFixed(1); }).join(' '); };
     return { max: max, x: x, y: y, line: line, area: function (k) { return L + ',' + (H - B) + ' ' + line(k) + ' ' + x(series.length - 1).toFixed(1) + ',' + (H - B); } };
   };
   const s = d.series;
   const peak = s.reduce(function (m, p) { return p.down > m.down ? p : m; }, { down: 0, t: '' }); %>
<style>
  .omada-kpi { font-size: 1.6rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .omada-chart { width: 100%; height: auto; display: block; }
  .omada-chart text { font-size: 11px; fill: currentColor; opacity: .7; }
  .omada-chart .grid { stroke: currentColor; opacity: .15; }
  .omada-bar { height: .5rem; border-radius: .25rem; background: var(--bs-primary); min-width: 2px; }
  .omada-leg { display: inline-block; width: .7rem; height: .7rem; border-radius: 2px; vertical-align: -1px; }
</style>
<% if (controllers.length && !sites.length) { %>
  <div class="alert alert-secondary">Todavía no se ha leído ningún sitio. <%= ['superadmin', 'admin'].includes(currentUser.role) ? 'Pulse «Leer ahora».' : 'La lectura automática es cada 5 minutos.' %></div>
<% } %>
<% if (sites.length) { %>
<div class="row g-3 mb-3" id="omada_kpis">
  <div class="col-6 col-lg-3"><div class="card p-3 h-100"><div class="small text-muted">Clientes conectados</div><div class="omada-kpi"><%= t.clients %></div>
    <div class="small text-muted"><a href="/red/omada/clientes<%= qs('ver=wifi') %>"><%= t.wireless %> por Wi-Fi</a> · <a href="/red/omada/clientes<%= qs('ver=cable') %>"><%= t.clients - t.wireless %> por cable</a></div></div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100"><div class="small text-muted">Equipos en línea</div>
    <div class="omada-kpi <%= t.online < t.devices ? 'text-danger' : '' %>"><%= t.online %> <span class="fs-6 text-muted fw-normal">de <%= t.devices %></span></div>
    <div class="small text-muted"><a href="/red/omada/equipos<%= qs('tipo=ap') %>"><%= t.aps %> AP</a> · <a href="/red/omada/equipos<%= qs('tipo=switch') %>"><%= t.switches %> switch</a></div></div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100"><div class="small text-muted">Descarga ahora</div><div class="omada-kpi"><%= fmtBps(t.down) %></div>
    <div class="small text-muted">suma de todos los clientes</div></div></div>
  <div class="col-6 col-lg-3"><div class="card p-3 h-100"><div class="small text-muted">Subida ahora</div><div class="omada-kpi"><%= fmtBps(t.up) %></div>
    <div class="small text-muted"><%= peak.down ? 'pico de descarga: ' + fmtBps(peak.down) + ' (' + String(peak.t).slice(5, 16) + ')' : 'sin historial aún' %></div></div></div>
</div>

<% if (d.offline.length) { %>
  <div class="alert alert-danger py-2" id="omada_caidos"><i class="bi bi-exclamation-octagon"></i> <strong><%= d.offline.length %> equipo(s) sin conexión:</strong>
    <%= d.offline.map(function (x) { return x.name + ' (' + x.site_name + ', ' + STATUS[x.status][0].toLowerCase() + ')'; }).join(' · ') %></div>
<% } %>

<div class="card p-3 mb-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h6 class="mb-0">Consumo de ancho de banda<%= site ? ' — ' + site.name : '' %></h6>
    <div class="btn-group btn-group-sm" role="group" aria-label="Periodo">
      <% Object.keys(RANGES).forEach(function (h) { %><a class="btn <%= Number(h) === hours ? 'btn-secondary' : 'btn-outline-secondary' %>" href="<%= qs('h=' + h) %>"><%= RANGES[h].replace('Últimas ', '').replace('Últimos ', '') %></a><% }); %>
    </div>
  </div>
  <% if (s.length < 2) { %>
    <p class="text-muted small mb-0">Aún no hay suficientes lecturas para dibujar el gráfico (se guarda una cada 5 minutos y se conservan 30 días).</p>
  <% } else { const c = chart(s, ['down', 'up']); const mid = Math.floor(s.length / 2); %>
    <div class="small mb-1"><span class="omada-leg" style="background: var(--bs-primary)"></span> Descarga &nbsp; <span class="omada-leg" style="background: var(--bs-warning)"></span> Subida</div>
    <svg class="omada-chart" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Velocidad de descarga y subida, <%= RANGES[hours].toLowerCase() %>. Máximo <%= fmtBps(c.max) %>." id="omada_grafico">
      <% [0, 0.5, 1].forEach(function (f) { %>
        <line class="grid" x1="<%= L %>" x2="<%= W - R %>" y1="<%= c.y(c.max * f).toFixed(1) %>" y2="<%= c.y(c.max * f).toFixed(1) %>"></line>
        <text x="<%= L - 6 %>" y="<%= (c.y(c.max * f) + 4).toFixed(1) %>" text-anchor="end"><%= fmtBps(Math.round(c.max * f)) %></text>
      <% }); %>
      <polygon points="<%= c.area('down') %>" fill="var(--bs-primary)" fill-opacity="0.18"></polygon>
      <polyline points="<%= c.line('down') %>" fill="none" stroke="var(--bs-primary)" stroke-width="1.6"></polyline>
      <polyline points="<%= c.line('up') %>" fill="none" stroke="var(--bs-warning)" stroke-width="1.6"></polyline>
      <text x="<%= L %>" y="<%= H - 6 %>"><%= String(s[0].t).slice(5, 16) %></text>
      <text x="<%= c.x(mid).toFixed(1) %>" y="<%= H - 6 %>" text-anchor="middle"><%= String(s[mid].t).slice(5, 16) %></text>
      <text x="<%= W - R %>" y="<%= H - 6 %>" text-anchor="end"><%= String(s[s.length - 1].t).slice(5, 16) %></text>
    </svg>
    <% const k = chart(s, ['clients']); %>
    <div class="small mt-3 mb-1"><span class="omada-leg" style="background: var(--bs-success)"></span> Clientes conectados (máximo <%= k.max %>)</div>
    <svg class="omada-chart" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Clientes conectados, <%= RANGES[hours].toLowerCase() %>. Máximo <%= k.max %>.">
      <% [0, 0.5, 1].forEach(function (f) { %>
        <line class="grid" x1="<%= L %>" x2="<%= W - R %>" y1="<%= k.y(k.max * f).toFixed(1) %>" y2="<%= k.y(k.max * f).toFixed(1) %>"></line>
        <text x="<%= L - 6 %>" y="<%= (k.y(k.max * f) + 4).toFixed(1) %>" text-anchor="end"><%= Math.round(k.max * f) %></text>
      <% }); %>
      <polygon points="<%= k.area('clients') %>" fill="var(--bs-success)" fill-opacity="0.18"></polygon>
      <polyline points="<%= k.line('clients') %>" fill="none" stroke="var(--bs-success)" stroke-width="1.6"></polyline>
    </svg>
    <p class="small text-muted mb-0 mt-2">Cada punto es la suma de la velocidad de todos los clientes en el momento de la lectura (cada 5 minutos); no es el consumo del enlace de Internet medido en el router.</p>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-lg-7"><div class="card p-3 h-100">
    <h6>Clientes con más consumo <span class="text-muted fw-normal small">(sesión actual)</span></h6>
    <% const maxT = d.topClients.reduce(function (m, c) { return Math.max(m, Number(c.traffic_down) + Number(c.traffic_up)); }, 0) || 1; %>
    <div class="table-responsive"><table class="table table-sm align-middle small mb-0" id="omada_top">
      <thead><tr><th data-orden="no">Cliente</th><th data-orden="no">Conectado a</th><th data-orden="no" class="text-end">Bajada</th><th data-orden="no" class="text-end">Subida</th><th data-orden="no" style="width: 22%"></th></tr></thead>
      <tbody>
        <% d.topClients.forEach(function (c) { const tot = Number(c.traffic_down) + Number(c.traffic_up); %>
          <tr><td><span class="fw-semibold"><%= c.inventory_name || c.name || c.mac %></span><div class="text-muted"><%= c.ip || c.mac %></div></td>
            <td><i class="bi <%= c.wireless ? 'bi-wifi' : 'bi-ethernet' %>"></i> <%= c.via_name || '—' %><div class="text-muted"><%= c.wireless ? c.ssid || '' : c.via_port ? 'puerto ' + c.via_port : '' %></div></td>
            <td class="text-end text-nowrap"><%= fmtBytes(c.traffic_down) %></td><td class="text-end text-nowrap"><%= fmtBytes(c.traffic_up) %></td>
            <td><div class="omada-bar" style="width: <%= Math.max(2, Math.round(tot * 100 / maxT)) %>%"></div></td></tr>
        <% }); %>
        <% if (!d.topClients.length) { %><tr><td colspan="5" class="text-center text-muted py-3">Sin clientes conectados.</td></tr><% } %>
      </tbody></table></div>
    <a class="small mt-2" href="/red/omada/clientes<%= qs() %>">Ver todos los clientes</a>
  </div></div>
  <div class="col-lg-5"><div class="card p-3 h-100">
    <h6>Clientes por punto de acceso</h6>
    <% const maxA = d.topAps.reduce(function (m, a) { return Math.max(m, a.clients); }, 0) || 1; %>
    <% d.topAps.forEach(function (a) { %>
      <div class="d-flex align-items-center gap-2 small mb-1"><span class="text-truncate" style="width: 45%" title="<%= a.name %>"><%= a.name %></span>
        <div class="flex-grow-1"><div class="omada-bar" style="width: <%= Math.max(2, Math.round(a.clients * 100 / maxA)) %>%; <%= a.status !== 1 ? 'background: var(--bs-danger)' : '' %>"></div></div>
        <span class="text-end" style="width: 2.5rem; font-variant-numeric: tabular-nums"><%= a.clients %></span></div>
    <% }); %>
    <% if (!d.topAps.length) { %><p class="text-muted small">Sin puntos de acceso.</p><% } %>
    <h6 class="mt-3">Clientes por red Wi-Fi (SSID)</h6>
    <% d.bySsid.forEach(function (g) { %>
      <div class="d-flex justify-content-between small border-bottom py-1"><span><%= g.label %></span><span><strong><%= g.clients %></strong> clientes · <%= fmtBytes(g.bytes) %></span></div>
    <% }); %>
    <% if (!d.bySsid.length) { %><p class="text-muted small mb-0">Sin clientes por Wi-Fi.</p><% } %>
  </div></div>
  <% if (d.weak.length) { %>
  <div class="col-12"><div class="card p-3">
    <h6>Clientes con señal débil <span class="text-muted fw-normal small">(menos de 40 %)</span></h6>
    <div class="d-flex flex-wrap gap-2 small">
      <% d.weak.forEach(function (c) { %><span class="badge text-bg-warning fw-normal"><%= c.inventory_name || c.name || c.mac %> · <%= c.signal_pct %> % · <%= c.via_name || '' %></span><% }); %>
    </div>
  </div></div>
  <% } %>
</div>
<% } %>
<%- include('../partials/foot') %>
