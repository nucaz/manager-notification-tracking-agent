<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Usuarios</h2>
  <a href="/usuarios/nuevo" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo usuario</a>
</div>

<div class="card p-3">
  <table class="table table-hover align-middle">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th><th>2FA</th><th>Acceso</th><th></th></tr></thead>
    <tbody>
      <% items.forEach(function(u) { %>
        <tr>
          <td><%= u.full_name %></td>
          <td><%= u.email %></td>
          <td><span class="badge bg-secondary text-uppercase"><%= u.role %></span></td>
          <td><%= u.active ? 'Sí' : 'No' %></td>
          <td>
            <% if (u.otp_enabled) { %>
              <span class="badge bg-success">Activo</span>
            <% } else { %>
              <span class="badge bg-warning text-dark">Pendiente</span>
            <% } %>
          </td>
          <td>
            <% if (u.locked) { %>
              <span class="badge bg-danger">Bloqueado</span>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td class="text-end">
            <a href="/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
            <% if (u.locked) { %>
              <form action="/usuarios/<%= u.id %>/desbloquear" method="post" class="d-inline" onsubmit="return confirm('¿Desbloquear esta cuenta?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-warning">Desbloquear</button>
              </form>
            <% } %>
            <% if (u.otp_enabled) { %>
              <form action="/usuarios/<%= u.id %>/restablecer-2fa" method="post" class="d-inline" onsubmit="return confirm('¿Restablecer el 2FA de este usuario? Deberá volver a configurarlo en su próximo inicio de sesión.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-secondary">Restablecer 2FA</button>
              </form>
            <% } %>
            <form action="/usuarios/<%= u.id %>/eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este usuario?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/foot') %>
