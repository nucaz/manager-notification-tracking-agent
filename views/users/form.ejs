<%- include('../partials/head', { title: title }) %>

<h2 class="mb-3"><%= title %></h2>

<form method="post" class="card p-4" action="<%= item.id ? '/usuarios/' + item.id + '/editar' : '/usuarios/nuevo' %>" style="max-width:760px;"
      <%- item.id ? 'onsubmit="return confirm(\'¿Guardar los cambios en este usuario? Se sobrescribirán los datos actuales.\');"' : '' %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="mb-3">
    <label class="form-label">Nombre completo *</label>
    <input type="text" name="full_name" class="form-control" required value="<%= item.full_name || '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label">Correo electrónico *</label>
    <input type="email" name="email" class="form-control" required value="<%= item.email || '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label">Contraseña <%= item.id ? '(dejar en blanco para no cambiar)' : '*' %></label>
    <input type="password" name="password" class="form-control" <%= item.id ? '' : 'required' %>>
  </div>
  <div class="mb-3">
    <label class="form-label">Número de WhatsApp (opcional)</label>
    <input type="text" name="whatsapp_number" class="form-control" value="<%= item.whatsapp_number || '' %>" placeholder="Ej: 51987654321 (sin +, sin espacios)">
    <div class="form-text">Si lo completas, este usuario podrá consultar la app por WhatsApp (solo admin/editor).</div>
  </div>
  <div class="mb-3">
    <label class="form-label">ID de chat de Telegram (opcional)</label>
    <input type="text" name="telegram_chat_id" class="form-control" value="<%= item.telegram_chat_id || '' %>" placeholder="Ej: 123456789">
    <div class="form-text">
      El usuario obtiene su ID escribiéndole <code>/start</code> al bot de Telegram (ver Configuración).
      Si lo completas, podrá consultar la app por Telegram (solo admin/editor).
    </div>
  </div>
  <div class="mb-3">
    <label class="form-label">Rol</label>
    <select name="role" class="form-select">
      <option value="lector" <%= item.role === 'lector' ? 'selected' : '' %>>Lector (solo ver)</option>
      <option value="editor" <%= item.role === 'editor' ? 'selected' : '' %>>Editor (crear/editar)</option>
      <option value="superadmin" <%= item.role === 'superadmin' ? 'selected' : '' %>>Superadministrador (todo, incluidas credenciales y usuarios)</option>
      <option value="admin" <%= item.role === 'admin' ? 'selected' : '' %>>Administrador (módulos; sin credenciales, usuarios ni respaldos)</option>
    </select>
  </div>
  <% if (item.id && moduleRows) { const PERFIL = { none: 'sin acceso', view: 'solo ver', edit: 'ver y editar' }; %>
    <div class="mb-3" id="permisos_especiales">
      <label class="form-label mb-1">Permisos especiales de este usuario</label>
      <% if (item.role === 'superadmin') { %>
        <div class="form-text">Un superadministrador siempre tiene acceso a todo; no lleva permisos especiales.</div>
      <% } else { %>
        <div class="form-text mb-2">Por defecto cada módulo sigue lo que diga su perfil (pantalla <a href="/permisos">Permisos</a>). Aquí puede darle a este usuario algo distinto en un módulo:
          quitarle el acceso, dejarlo solo de consulta, o permitirle editar aunque su perfil sea Lector. Si cambia el rol arriba, guarde y vuelva a entrar para ver sus valores por perfil.</div>
        <div class="table-responsive">
          <table class="table table-sm align-middle small mb-1" data-tabla="no">
            <thead><tr><th>Módulo</th><th>Por su perfil</th><th style="width: 16rem">Para este usuario</th></tr></thead>
            <tbody>
              <% moduleRows.forEach(function (m) { %>
                <tr class="<%= m.override ? 'table-warning' : '' %>">
                  <td><label for="um_<%= m.key %>" class="mb-0"><%= m.label %></label></td>
                  <td class="text-muted"><%= PERFIL[m.byRole] %></td>
                  <td><select class="form-select form-select-sm" name="um_<%= m.key %>" id="um_<%= m.key %>">
                    <option value="">Según su perfil</option>
                    <% Object.keys(ACCESS).forEach(function (k) { %><option value="<%= k %>" <%= m.override === k ? 'selected' : '' %>><%= ACCESS[k] %></option><% }); %>
                  </select></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="form-text">«Ver y editar» permite crear y modificar como un Editor; las acciones propias de un administrador siguen pidiendo ese perfil. En DevOps no hay solo lectura: quien entra puede hacer todo.</div>
      <% } %>
    </div>
  <% } %>
  <% if (item.id) { %>
    <div class="form-check mb-3">
      <input type="checkbox" class="form-check-input" name="active" id="active" <%= item.active ? 'checked' : '' %>>
      <label class="form-check-label" for="active">Usuario activo</label>
    </div>
  <% } %>
  <button type="submit" class="btn btn-primary">Guardar</button>
  <a href="/usuarios" class="btn btn-outline-secondary">Cancelar</a>
</form>

<% if (item.id && moduleRows && item.role !== 'superadmin') { const guardados = moduleRows.filter(function (m) { return m.override; }); %>
<form method="post" action="/usuarios/<%= item.id %>/copiar-permisos" class="card p-4 mt-3" style="max-width:760px;" id="copiar_permisos">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h6 class="mb-1">Copiar estos permisos especiales a otros usuarios</h6>
  <% if (!guardados.length) { %>
    <p class="text-muted small mb-0">Este usuario no tiene permisos especiales guardados. Configúrelos arriba, pulse Guardar y vuelva aquí para copiarlos.</p>
  <% } else if (!others.length) { %>
    <p class="text-muted small mb-0">No hay otros usuarios a quienes copiarlos.</p>
  <% } else { %>
    <p class="small text-muted mb-2">Se copia lo que está <strong>guardado</strong>:
      <% guardados.forEach(function (m) { %><span class="badge text-bg-<%= m.override === 'none' ? 'danger' : m.override === 'edit' ? 'success' : 'secondary' %> fw-normal me-1"><%= m.label.replace(/ \(.*/, '') %>: <%= ACCESS[m.override].toLowerCase() %></span><% }); %>
      <br>Cada usuario marcado queda con exactamente estos permisos especiales; los que tuviera se reemplazan. Su perfil no cambia.</p>
    <div class="d-flex flex-column gap-1 border rounded p-2 mb-3" style="max-height: 14rem; overflow: auto">
      <% others.forEach(function (u) { %>
        <div class="form-check"><input class="form-check-input" type="checkbox" name="destino" value="<%= u.id %>" id="destino_<%= u.id %>">
          <label class="form-check-label small" for="destino_<%= u.id %>"><strong><%= u.full_name %></strong> · <%= ROLES[u.role] || u.role %><%= u.active ? '' : ' · inactivo' %>
            <% if (u.special) { %><span class="text-warning-emphasis">· ya tiene <%= u.special %> permiso(s) especial(es), se reemplazarán</span><% } %></label></div>
      <% }); %>
    </div>
    <button type="submit" class="btn btn-outline-primary" onclick="return confirm('¿Copiar los permisos especiales a los usuarios marcados? Se reemplazan los que tengan.');"><i class="bi bi-copy"></i> Copiar a los marcados</button>
  <% } %>
</form>
<% } %>

<%- include('../partials/foot') %>
