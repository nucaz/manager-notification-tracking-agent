<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h2 class="mb-0"><%= item.common_name %></h2>
    <span class="badge <%= item.computed_status === 'vencido' ? 'bg-danger' : item.computed_status === 'por_vencer' ? 'bg-warning text-dark' : item.computed_status === 'activo' ? 'bg-success' : 'bg-secondary' %>">
      <%= item.days_left !== null ? item.days_left + ' día(s) restantes' : 'sin fecha de vencimiento' %>
    </span>
  </div>
  <div>
    <% if (currentUser.role !== 'lector') { %>
      <a href="/certificados/<%= item.id %>/editar" class="btn btn-outline-primary">Editar</a>
      <form action="/glpi/sincronizar/certificate/<%= item.id %>" method="post" class="d-inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-secondary" type="submit" title="Crear/actualizar como Contrato en GLPI">
          <i class="bi bi-cloud-upload"></i> Sincronizar con GLPI
        </button>
      </form>
      <form action="/certificados/<%= item.id %>/eliminar" method="post" class="d-inline"
            onsubmit="return confirm('¿Eliminar este certificado? Esta acción no se puede deshacer.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-danger" type="submit">Eliminar</button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card p-3">
      <h5>Detalle</h5>
      <table class="table table-sm">
        <tr><th style="width:220px;">Tipo</th><td><%= item.certificate_type %></td></tr>
        <tr><th>Entidad certificadora</th><td><%= item.issuer || '—' %></td></tr>
        <tr><th>Dominio vinculado</th><td><%= item.domain_name || '—' %></td></tr>
        <tr><th>Fecha de emisión</th><td><%= item.issue_date || '—' %></td></tr>
        <tr><th>Fecha de vencimiento</th><td><%= item.expiration_date || '—' %></td></tr>
        <tr><th>Renovación automática</th><td><%= item.auto_renew ? 'Sí' : 'No' %></td></tr>
        <tr><th>Costo</th><td>
          <%= item.cost ? item.cost + ' ' + item.currency : '—' %>
          <% if (item.cost && item.currency === 'USD' && exchangeRate) { %>
            <span class="text-muted small">(≈ S/ <%= (item.cost * exchangeRate.rate).toFixed(2) %>, BCRP <%= exchangeRate.date.split('-').reverse().slice(0,2).join('/') %>)</span>
          <% } %>
        </td></tr>
        <tr><th>Responsable</th><td><%= item.responsible || '—' %></td></tr>
        <tr><th>Local / sede</th><td><%= item.site_location || '—' %></td></tr>
        <tr><th>Contrato GLPI sincronizado</th><td><%= item.glpi_contract_id || '—' %></td></tr>
        <tr><th>Notas</th><td><%= item.notes || '—' %></td></tr>
      </table>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card p-3">
      <h5>Adjuntos (certificado, cadena, facturas)</h5>
      <% if (currentUser.role !== 'lector') { %>
        <form action="/adjuntos/subir/certificate/<%= item.id %>" method="post" enctype="multipart/form-data" class="mb-3 border-bottom pb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-2">
            <select name="doc_type" class="form-select form-select-sm">
              <option value="contrato">Contrato</option>
              <option value="adenda">Adenda</option>
              <option value="factura">Factura</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="mb-2">
            <input type="text" name="description" class="form-control form-control-sm" placeholder="Descripción (opcional)">
          </div>
          <div class="mb-2">
            <input type="file" name="file" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-primary">Subir archivo</button>
        </form>
      <% } %>
      <ul class="list-group list-group-flush">
        <% attachments.forEach(function(a) { %>
          <%- include('../partials/attachment_item', { a: a }) %>
        <% }); %>
        <% if (attachments.length === 0) { %>
          <li class="list-group-item px-0 text-muted">Sin archivos adjuntos.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
