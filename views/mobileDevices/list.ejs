<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h2 class="mb-0">Celulares <span class="text-muted fs-6">(<%= items.length %>)</span></h2>
  <div class="d-flex flex-wrap gap-1">
    <a href="/celulares/chips" class="btn btn-outline-primary"><i class="bi bi-sim"></i> Chips</a>
    <a href="/celulares/recibos" class="btn btn-outline-primary"><i class="bi bi-receipt"></i> Recibos</a>
    <a href="/celulares/inventario" class="btn btn-outline-secondary"><i class="bi bi-clipboard-data"></i> Inventario mensual</a>
    <a href="/celulares/resumen" class="btn btn-outline-secondary"><i class="bi bi-bar-chart"></i> Resumen</a>
    <div class="btn-group">
      <a href="/celulares/exportar.xlsx<%= exportQuery %>" class="btn btn-outline-success" title="Exporta todos los celulares (o los filtrados) con todos sus datos">
        <i class="bi bi-file-earmark-excel"></i> Exportar Excel
      </a>
      <a href="/celulares/exportar.csv<%= exportQuery %>" class="btn btn-outline-success">CSV</a>
    </div>
    <% if (currentUser.role !== 'lector') { %>
      <a href="/celulares/importar" class="btn btn-outline-secondary"><i class="bi bi-upload"></i> Importar</a>
      <a href="/celulares/nuevo" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo celular</a>
    <% } %>
  </div>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-auto">
    <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Buscar por IMEI, código, número o usuario...">
  </div>
  <div class="col-auto">
    <select name="area" class="form-select">
      <option value="">Todas las áreas</option>
      <% areas.forEach(function(a) { %>
        <option value="<%= a %>" <%= area === a ? 'selected' : '' %>><%= a %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <select name="sede" class="form-select">
      <option value="">Todas las sedes</option>
      <% sedes.forEach(function(s) { %>
        <option value="<%= s %>" <%= sede === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <select name="status" class="form-select">
      <option value="">Todos los estados</option>
      <% Object.keys(mobileLabels.DEVICE_STATUS).forEach(function(k) { %>
        <option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= mobileLabels.DEVICE_STATUS[k].label %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-secondary" type="submit">Filtrar</button>
  </div>
  <div class="col-auto dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
      <i class="bi bi-layout-three-columns"></i> Columnas
    </button>
    <div class="dropdown-menu p-2" id="columnPicker" style="min-width:220px;">
      <div class="form-text mb-1">Elige qué columnas ver (se recuerda en este navegador).</div>
      <% [
        ['sede', 'Sede'], ['operadora', 'Operadora'], ['numero', 'Número de línea'], ['numero2', 'Número 2 (doble SIM)'],
        ['compra', 'Fecha de compra'], ['condicion', 'Condición'],
        ['registrado', 'Registrado'], ['actualizado', 'Últ. actualización'],
      ].forEach(function(c) { %>
        <div class="form-check">
          <input type="checkbox" class="form-check-input col-toggle" id="col_<%= c[0] %>" data-col="<%= c[0] %>">
          <label class="form-check-label" for="col_<%= c[0] %>"><%= c[1] %></label>
        </div>
      <% }); %>
    </div>
  </div>
</form>

<% if (chipsSueltos) { %>
  <div class="alert alert-info py-2">
    <i class="bi bi-sim"></i> Además, <strong><%= chipsSueltos %> chip(s)</strong> con "<%= q %>" no están en ningún celular (en stock, asignados sin celular o de baja).
    <a href="/celulares/chips?q=<%= encodeURIComponent(q) %>">Verlos en Chips</a>
  </div>
<% } %>

<div class="card p-3">
  <% if (currentUser.role !== 'lector') { %>
    <form id="bulkDeleteForm" method="post" action="/celulares/eliminar-multiple"
      onsubmit="return confirm('¿Eliminar los ' + document.querySelectorAll('.row-check:checked').length + ' celular(es) seleccionado(s)? Esta acción no se puede deshacer.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-2">
        <button type="submit" id="bulkDeleteBtn" class="btn btn-sm btn-outline-danger" disabled>Eliminar seleccionados</button>
      </div>
  <% } %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <% if (currentUser.role !== 'lector') { %>
            <th><input type="checkbox" id="selectAllCheckbox" onchange="document.querySelectorAll('tr:not([hidden]) .row-check').forEach(function(cb){cb.checked = this.checked;}, this); updateBulkDeleteButton();"></th>
          <% } %>
          <th>IMEI</th><th>Código</th><th>Modelo</th><th>Área</th><th data-col="sede">Sede</th>
          <th data-col="operadora">Operadora</th><th data-col="numero">Número de línea</th><th data-col="numero2">Número 2</th>
          <th data-col="compra">Fecha de compra</th><th data-col="condicion">Condición</th>
          <th>Usuario asignado</th><th>Estado</th>
          <th data-col="registrado">Registrado</th><th data-col="actualizado">Últ. actualización</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr>
            <% if (currentUser.role !== 'lector') { %>
              <td><input type="checkbox" name="ids" value="<%= item.id %>" class="row-check" onchange="updateBulkDeleteButton();"></td>
            <% } %>
            <td><a href="/celulares/<%= item.id %>"><%= item.imei %></a></td>
            <td><%= item.asset_code || '—' %></td>
            <td><%= item.model || '—' %></td>
            <td><%= item.area %></td>
            <td data-col="sede"><%= item.sede || '—' %></td>
            <td data-col="operadora"><%= item.operadora || '—' %></td>
            <td data-col="numero"><%= item.phone_number || '—' %></td>
            <td data-col="numero2"><%= item.numero_2 || '—' %></td>
            <td data-col="compra"><%= item.purchase_date || '—' %></td>
            <td data-col="condicion"><%= item.condicion === 'nuevo' ? 'Nuevo' : item.condicion === 'usado' ? 'Usado' : '—' %></td>
            <td><%= item.holder_name || '—' %></td>
            <td>
              <span class="badge <%= mobileLabels.deviceStatus(item.status).badge %>">
                <%= mobileLabels.deviceStatus(item.status).label %>
              </span>
            </td>
            <td data-col="registrado" class="text-nowrap small"><%= item.created_at ? String(item.created_at).slice(0, 16) : '—' %></td>
            <td data-col="actualizado" class="text-nowrap small"><%= item.updated_at ? String(item.updated_at).slice(0, 16) : '—' %></td>
            <td class="text-end">
              <a href="/celulares/<%= item.id %>" class="btn btn-sm btn-outline-secondary">Ver</a>
              <a href="/celulares/<%= item.id %>/qr.png?download=1" class="btn btn-sm btn-outline-secondary" title="Descargar código QR">
                <i class="bi bi-qr-code"></i>
              </a>
              <% if (currentUser.role !== 'lector') { %>
                <a href="/celulares/<%= item.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (items.length === 0) { %>
          <tr><td colspan="15" class="text-center text-muted py-4">No hay celulares registrados.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (currentUser.role !== 'lector') { %>
    </form>
  <% } %>
</div>

<% if (currentUser.role !== 'lector') { %>
  <script>
    function updateBulkDeleteButton() {
      var count = document.querySelectorAll('.row-check:checked').length;
      var all = document.querySelectorAll('tr:not([hidden]) .row-check'); // los de la pagina a la vista
      var btn = document.getElementById('bulkDeleteBtn');
      btn.disabled = count === 0;
      btn.textContent = count > 0 ? 'Eliminar seleccionados (' + count + ')' : 'Eliminar seleccionados';
      document.getElementById('selectAllCheckbox').checked = count > 0 && count === all.length;
    }
  </script>
<% } %>

<script>
(function () {
  // Que columnas opcionales se ven en este listado - preferencia de cada
  // navegador (localStorage), no del servidor: por eso no viaja en la URL
  // ni se guarda en la base de datos.
  var DEFAULTS = { sede: true, operadora: false, numero: false, compra: false, condicion: false, registrado: true, actualizado: true };
  var prefs = DEFAULTS;
  try {
    var saved = JSON.parse(localStorage.getItem('glpiCelularesColumnas') || 'null');
    if (saved) prefs = Object.assign({}, DEFAULTS, saved);
  } catch (e) {}

  function apply() {
    Object.keys(prefs).forEach(function (key) {
      var visible = prefs[key];
      document.querySelectorAll('[data-col="' + key + '"]').forEach(function (el) {
        el.classList.toggle('d-none', !visible);
      });
      var cb = document.getElementById('col_' + key);
      if (cb) cb.checked = visible;
    });
  }
  apply();

  document.querySelectorAll('.col-toggle').forEach(function (cb) {
    cb.addEventListener('change', function () {
      prefs[cb.getAttribute('data-col')] = cb.checked;
      apply();
      try { localStorage.setItem('glpiCelularesColumnas', JSON.stringify(prefs)); } catch (e) {}
    });
  });
})();
</script>

<%- include('../partials/foot') %>
