<%- include('../partials/head', { title: title }) %>

<h2 class="mb-3"><%= title %></h2>

<form method="post" class="card p-4" action="<%= item.id ? '/celulares/' + item.id + '/editar' : '/celulares/nuevo' %>"
      <%- item.id ? 'onsubmit="return confirm(\'¿Guardar los cambios en este registro? Se sobrescribirán los datos actuales.\');"' : '' %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">IMEI *</label>
      <input type="text" name="imei" class="form-control" required value="<%= item.imei || '' %>"
        inputmode="numeric" pattern="\d{15}" maxlength="15" title="15 dígitos numéricos (estándar GSMA)">
      <div class="form-text">15 dígitos numéricos (TAC + serie + dígito de control).</div>
    </div>
    <div class="col-md-4">
      <label class="form-label">Código de activo</label>
      <input type="text" name="asset_code" class="form-control" value="<%= item.asset_code || '' %>" placeholder="Ej: A-00868"
        maxlength="12" pattern="[A-Za-z0-9-]{1,12}" title="Alfanumérico (se permite un guion), máximo 12 caracteres">
      <div class="form-text">
        <% if (!item.id) { %>Sugerido automáticamente según el correlativo configurado — puedes cambiarlo. <% } %>
        Alfanumérico (se permite guion), máximo 12 caracteres. Configurable en Configuración.
      </div>
    </div>
    <div class="col-md-4">
      <label class="form-label">Marca</label>
      <% const marcaEsOtro = item.brand && !marcas.includes(item.brand); %>
      <select name="brand" id="brand_select" class="form-select" onchange="document.getElementById('brand_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% marcas.forEach(function(m) { %>
          <option value="<%= m %>" <%= item.brand === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
        <option value="<%= marcaEsOtro ? item.brand : '__otro__' %>" <%= marcaEsOtro ? 'selected' : '' %>>
          <%= marcaEsOtro ? item.brand : 'Otro (especificar)...' %>
        </option>
      </select>
      <input type="text" id="brand_otro" class="form-control mt-2" placeholder="Especificar marca..." maxlength="100" <%= marcaEsOtro ? '' : 'hidden' %>
        value="<%= marcaEsOtro ? item.brand : '' %>"
        oninput="var o=document.querySelector('#brand_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
    </div>
    <div class="col-md-4">
      <label class="form-label">Modelo</label>
      <% const modeloEsOtro = item.model && !modelos.some(function(m) { return m.model === item.model && (!item.brand || m.brand === item.brand); }); %>
      <select name="model" id="model_select" class="form-select" onchange="document.getElementById('model_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% modelos.forEach(function(m) { %>
          <option value="<%= m.model %>" data-marca="<%= m.brand %>" <%= item.model === m.model && (!item.brand || item.brand === m.brand) ? 'selected' : '' %>><%= m.model %></option>
        <% }); %>
        <option value="<%= modeloEsOtro ? item.model : '__otro__' %>" <%= modeloEsOtro ? 'selected' : '' %>>
          <%= modeloEsOtro ? item.model : 'Otro (especificar)...' %>
        </option>
      </select>
      <input type="text" id="model_otro" class="form-control mt-2" placeholder="Especificar modelo..." maxlength="20" <%= modeloEsOtro ? '' : 'hidden' %>
        value="<%= modeloEsOtro ? item.model : '' %>"
        oninput="var o=document.querySelector('#model_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
      <div class="form-text">Se ofrecen los modelos de la marca elegida (catálogo en Configuración → Catálogos → Modelos). Alfanumérico, máximo 20 caracteres.</div>
      <script>
      // Al elegir la marca, el selector de modelo muestra solo los de esa marca.
      (function () {
        var brand = document.getElementById('brand_select');
        var model = document.getElementById('model_select');
        if (!brand || !model) return;
        var sync = function () {
          var b = brand.value === '__otro__' ? '' : brand.value;
          Array.prototype.forEach.call(model.options, function (o) {
            var m = o.getAttribute('data-marca');
            if (m === null) return; // "Seleccionar" y "Otro"
            o.hidden = !!b && m !== b;
            o.disabled = o.hidden;
          });
          var sel = model.options[model.selectedIndex];
          if (sel && sel.hidden) model.value = '';
        };
        brand.addEventListener('change', sync);
        sync();
      })();
      </script>
    </div>
    <div class="col-md-4">
      <label class="form-label">Operadora</label>
      <% const operadoraEsOtro = item.operadora && !operadoras.includes(item.operadora); %>
      <select name="operadora" id="operadora_select" class="form-select" onchange="document.getElementById('operadora_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% operadoras.forEach(function(o) { %>
          <option value="<%= o %>" <%= item.operadora === o ? 'selected' : '' %>><%= o %></option>
        <% }); %>
        <option value="<%= operadoraEsOtro ? item.operadora : '__otro__' %>" <%= operadoraEsOtro ? 'selected' : '' %>>
          <%= operadoraEsOtro ? item.operadora : 'Otro (especificar)...' %>
        </option>
      </select>
      <input type="text" id="operadora_otro" class="form-control mt-2" placeholder="Especificar operadora..." maxlength="50" <%= operadoraEsOtro ? '' : 'hidden' %>
        value="<%= operadoraEsOtro ? item.operadora : '' %>"
        oninput="var o=document.querySelector('#operadora_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
    </div>
    <div class="col-md-4">
      <label class="form-label">Fecha de compra</label>
      <input type="date" name="purchase_date" class="form-control" value="<%= item.purchase_date || '' %>">
    </div>
    <div class="col-md-4">
      <label class="form-label">Condición</label>
      <select name="condicion" class="form-select">
        <option value="">— Sin especificar —</option>
        <option value="nuevo" <%= item.condicion === 'nuevo' ? 'selected' : '' %>>Nuevo</option>
        <option value="usado" <%= item.condicion === 'usado' ? 'selected' : '' %>>Usado</option>
      </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
      <div class="form-check">
        <input type="checkbox" class="form-check-input" name="has_chip" id="has_chip" <%= item.has_chip ? 'checked' : '' %>>
        <label class="form-check-label" for="has_chip">Tiene chip</label>
      </div>
      <div class="form-text ms-2">Queda registrado en <a href="/celulares/chips">Chips</a>.</div>
    </div>
    <div class="col-md-2">
      <label class="form-label">País</label>
      <% const defaultCountry = countries.find(function(c) { return c.calling_code === '51'; }); %>
      <% const selectedCountryId = item.phone_country_code_id || (defaultCountry ? defaultCountry.id : ''); %>
      <select name="phone_country_code_id" id="phone_country_select" class="form-select"
              onchange="var o=this.options[this.selectedIndex]; var len=o.getAttribute('data-length'); var n=document.getElementById('phone_number_input'); if (len) { n.maxLength = len; n.placeholder = len + ' dígitos'; } else { n.removeAttribute('maxlength'); n.placeholder=''; }">
        <% countries.forEach(function(c) { %>
          <option value="<%= c.id %>" data-length="<%= c.mobile_length %>" <%= String(selectedCountryId) === String(c.id) ? 'selected' : '' %>>
            +<%= c.calling_code %> <%= c.country_name %>
          </option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">Número de línea</label>
      <% const selectedCountry = countries.find(function(c) { return String(c.id) === String(selectedCountryId); }); %>
      <input type="text" name="phone_number" id="phone_number_input" class="form-control" value="<%= item.phone_number || '' %>"
        inputmode="numeric" pattern="\d*" <%- selectedCountry ? 'maxlength="' + selectedCountry.mobile_length + '" placeholder="' + selectedCountry.mobile_length + ' dígitos"' : '' %>>
    </div>
    <div class="col-md-4">
      <label class="form-label">Estado</label>
      <select name="status" class="form-select">
        <option value="en_stock" <%= !item.status || item.status === 'en_stock' ? 'selected' : '' %>>En stock</option>
        <option value="asignado" <%= item.status === 'asignado' ? 'selected' : '' %>>Asignado</option>
        <option value="en_reparacion" <%= item.status === 'en_reparacion' ? 'selected' : '' %>>En reparación</option>
        <option value="de_baja" <%= item.status === 'de_baja' ? 'selected' : '' %>>De baja</option>
        <% if (item.status === 'en_decomiso') { %>
          <option value="en_decomiso" selected>En decomiso (se resuelve desde el detalle)</option>
        <% } %>
      </select>
      <div class="form-text">
        La asignación/reasignación a una persona, y el registro de reparaciones/accidentes/decomisos/bajas,
        se hacen desde el detalle del celular (después de guardarlo aquí), no en este formulario.
      </div>
    </div>

    <div class="col-md-6">
      <label class="form-label">Área *</label>
      <% const areaEsOtro = item.area && !areas.includes(item.area); %>
      <select name="area" id="area_select" class="form-select" required onchange="document.getElementById('area_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% areas.forEach(function(a) { %>
          <option value="<%= a %>" <%= item.area === a ? 'selected' : '' %>><%= a %></option>
        <% }); %>
        <option value="<%= areaEsOtro ? item.area : '__otro__' %>" <%= areaEsOtro ? 'selected' : '' %>>
          <%= areaEsOtro ? item.area : 'Otro (especificar)...' %>
        </option>
      </select>
      <input type="text" id="area_otro" class="form-control mt-2" placeholder="Especificar área..." <%= areaEsOtro ? '' : 'hidden' %>
        value="<%= areaEsOtro ? item.area : '' %>"
        oninput="var o=document.querySelector('#area_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
    </div>
    <div class="col-md-6">
      <label class="form-label">Sede</label>
      <% const sedeEsOtro = item.sede && !sedes.includes(item.sede); %>
      <select name="sede" id="sede_select" class="form-select" onchange="document.getElementById('sede_otro').hidden = this.value !== '__otro__';">
        <option value="">— Seleccionar —</option>
        <% sedes.forEach(function(s) { %>
          <option value="<%= s %>" <%= item.sede === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
        <option value="<%= sedeEsOtro ? item.sede : '__otro__' %>" <%= sedeEsOtro ? 'selected' : '' %>>
          <%= sedeEsOtro ? item.sede : 'Otro (especificar)...' %>
        </option>
      </select>
      <input type="text" id="sede_otro" class="form-control mt-2" placeholder="Especificar sede..." <%= sedeEsOtro ? '' : 'hidden' %>
        value="<%= sedeEsOtro ? item.sede : '' %>"
        oninput="var o=document.querySelector('#sede_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
    </div>

    <div class="col-12">
      <label class="form-label">Notas</label>
      <textarea name="notes" class="form-control" rows="3" maxlength="250"><%= item.notes || '' %></textarea>
      <div class="form-text">Máximo 250 caracteres.</div>
    </div>
  </div>

  <div class="mt-4">
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="<%= item.id ? '/celulares/' + item.id : '/celulares' %>" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
