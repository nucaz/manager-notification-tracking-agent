<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h2 class="mb-0"><%= item.imei %></h2>
    <span class="badge <%= mobileLabels.deviceStatus(item.status).badge %>">
      <%= mobileLabels.deviceStatus(item.status).label %>
    </span>
  </div>
  <div>
    <a href="/celulares" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al listado</a>
    <% if (currentUser.role !== 'lector') { %>
      <a href="/celulares/<%= item.id %>/editar" class="btn btn-outline-primary">Editar</a>
      <form action="/celulares/<%= item.id %>/eliminar" method="post" class="d-inline"
            onsubmit="return confirm('¿Eliminar este celular (IMEI <%= item.imei %>)? Esta acción no se puede deshacer.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-danger" type="submit">Eliminar</button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card p-3 mb-3">
      <h5>Detalle</h5>
      <table class="table table-sm">
        <tr><th style="width:220px;">Código de activo</th><td><%= item.asset_code || '—' %></td></tr>
        <tr><th>Marca</th><td><%= item.brand || '—' %></td></tr>
        <tr><th>Modelo</th><td><%= item.model || '—' %></td></tr>
        <tr><th>Tiene chip</th><td><%= item.has_chip ? 'Sí' : 'No' %><%= lines.length > 1 ? ' (' + lines.length + ' chips, doble SIM)' : '' %></td></tr>
        <tr><th>Número de línea</th><td><%= item.phone_number ? ('+' + item.calling_code + ' ' + item.phone_number + (item.country_name ? ' (' + item.country_name + ')' : '')) : '—' %></td></tr>
        <tr><th>Operadora</th><td><%= item.operadora || '—' %></td></tr>
        <tr><th>Fecha de compra</th><td><%= item.purchase_date || '—' %></td></tr>
        <tr><th>Condición</th><td><%= item.condicion === 'nuevo' ? 'Nuevo' : item.condicion === 'usado' ? 'Usado' : '—' %></td></tr>
        <tr><th>Área</th><td><%= item.area %></td></tr>
        <tr><th>Sede</th><td><%= item.sede || '—' %></td></tr>
        <tr><th>Notas</th><td><%= item.notes || '—' %></td></tr>
        <tr><th>Registrado</th><td><%= item.created_at || '—' %></td></tr>
        <tr><th>Última actualización</th><td><%= item.updated_at || '—' %></td></tr>
      </table>
    </div>

    <div class="card p-3 mb-3" id="chips">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Chips en este celular <span class="text-muted small">(<%= lines.length %> de <%= maxChips %>)</span></h5>
        <a href="/celulares/chips" class="small">Ver todos los chips</a>
      </div>
      <% if (!lines.length) { %>
        <p class="text-muted mb-0 mt-2">Sin chip.</p>
      <% } else { %>
        <table class="table table-sm mb-0 mt-2" data-tabla="no">
          <thead><tr><th>Número</th><th>Operadora</th><th>Plan</th><th>Estado</th><th></th></tr></thead>
          <tbody>
            <% lines.forEach(function(l) { %>
              <tr>
                <td><%= l.calling_code ? '+' + l.calling_code + ' ' : '' %><%= l.phone_number %> <span class="small text-muted"><%= l.es_principal ? '(principal)' : '(2.º chip)' %></span></td>
                <td><%= l.operadora || '—' %></td>
                <td><%= l.plan || '—' %><%= l.costo_plan !== null ? ' · S/ ' + (Number(l.costo_plan) - (Number(l.descuento_plan) || 0)).toFixed(2) + (Number(l.descuento_plan) ? ' (sin descuento S/ ' + Number(l.costo_plan).toFixed(2) + ')' : '') : '' %></td>
                <td><span class="badge <%= mobileLabels.lineEstado(l.estado).badge %>"><%= mobileLabels.lineEstado(l.estado).label %></span></td>
                <td class="text-end text-nowrap">
                  <% if (currentUser.role !== 'lector') { %>
                    <% if (!l.es_principal) { %>
                    <form action="/celulares/<%= item.id %>/chips/<%= l.id %>/principal" method="post" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-primary" type="submit" title="Que este número pase a ser el principal del celular">Hacer principal</button>
                    </form>
                    <% } %>
                    <form action="/celulares/<%= item.id %>/chips/<%= l.id %>/retirar" method="post" class="d-inline"
                          onsubmit="return confirm('¿Retirar el chip <%= l.phone_number %> de este celular? Queda en stock.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-danger" type="submit">Retirar</button>
                    </form>
                  <% } %>
                  <a href="/celulares/chips/<%= l.id %>" class="btn btn-sm btn-outline-secondary">Ver chip</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
      <% if (currentUser.role !== 'lector' && item.status !== 'de_baja') { %>
        <% if (lines.length < maxChips) { %>
        <hr>
        <h6 class="mb-1"><%= lines.length ? 'Agregar 2.º chip (doble SIM)' : 'Agregar chip' %></h6>
        <form action="/celulares/<%= item.id %>/chips/agregar" method="post" class="row g-2 align-items-end" id="form_agregar_chip">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-sm-4">
            <label class="form-label small mb-1" for="chip_numero">Número *</label>
            <input type="text" class="form-control form-control-sm" id="chip_numero" name="numero" required inputmode="numeric" maxlength="15" placeholder="912345678">
          </div>
          <div class="col-sm-4">
            <label class="form-label small mb-1" for="chip_operadora">Operadora (si el chip es nuevo)</label>
            <select class="form-select form-select-sm" id="chip_operadora" name="operadora">
              <option value="">—</option>
              <% operadoras.forEach(function(o) { %><option value="<%= o %>"><%= o %></option><% }); %>
            </select>
          </div>
          <div class="col-sm-4">
            <label class="form-label small mb-1" for="chip_iccid">ICCID (opcional)</label>
            <input type="text" class="form-control form-control-sm" id="chip_iccid" name="iccid" inputmode="numeric" maxlength="22">
          </div>
          <div class="col-12 d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-sim"></i> Poner en este celular</button>
            <span class="form-text m-0">Si el número ya está registrado como chip en stock, se toma ese; si no existe, se registra en el momento.<%= lines.length ? ' Queda como 2.º chip; luego puede hacerlo principal.' : ' Será el número principal.' %></span>
          </div>
        </form>
        <% } else { %>
        <p class="small text-muted mt-2 mb-0">Tiene los <%= maxChips %> chips que admite un celular doble SIM. Para entregarle a la persona chips extra, asígneselos desde Chips como <strong>repuesto</strong>.</p>
        <% } %>
      <% } %>
    </div>

    <div class="card p-3 mb-3">
      <h5>Historial de asignaciones</h5>
      <% if (history.length === 0) { %>
        <p class="text-muted mb-0">Sin asignaciones anteriores.</p>
      <% } else { %>
        <table class="table table-sm">
          <thead><tr><th>Usuario</th><th>DNI</th><th>Cargo</th><th>Área / Sede</th><th>Solicitado por</th><th>Desde</th><th>Hasta</th><th>Cómo terminó</th><th>Antes de la asignación</th><th>Durante</th><th>Observación</th></tr></thead>
          <tbody>
            <% history.forEach(function(h) { %>
              <tr>
                <td><%= h.holder_name %></td>
                <td><%= h.dni || '—' %></td>
                <td><%= h.cargo || '—' %><%= h.turno ? ' · ' + h.turno : '' %></td>
                <td><%= h.lugar || 'Sin dato' %></td>
                <td class="small"><% if (h.requested_by_name) { %><%= h.requested_by_name %><%= h.requested_by_cargo ? ' (' + h.requested_by_cargo + ')' : '' %><div class="text-muted"><%= h.request_date %><%= h.request_ref ? ' · ' + h.request_ref : '' %></div><% } else { %><span class="text-muted">Sin registro</span><% } %></td>
                <td class="text-nowrap"><%= h.assigned_date || '—' %></td>
                <td class="text-nowrap"><%= h.returned_date %></td>
                <td><%= h.termino || '—' %></td>
                <td class="small"><%= h.antes.length ? h.antes.join('; ') : 'Sin incidentes' %></td>
                <td class="small"><%= h.durante.length ? h.durante.join('; ') : 'Sin incidentes' %></td>
                <td class="small"><%= h.observacion || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card p-3">
      <h5>Reparaciones, accidentes, decomisos y bajas</h5>
      <% if (incidents.length === 0) { %>
        <p class="text-muted mb-0">Sin incidentes registrados.</p>
      <% } else { %>
        <table class="table table-sm">
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Descripción</th><th>Costo</th><th>Resuelta</th><th></th></tr></thead>
          <tbody>
            <% incidents.forEach(function(inc) { %>
              <tr>
                <td><%= inc.fecha %></td>
                <td>
                  <span class="badge <%= mobileLabels.incidentTipo(inc.tipo).badge %>">
                    <%= mobileLabels.incidentTipo(inc.tipo).label %>
                  </span>
                  <% if (inc.motivo) { %><div class="small text-muted"><%= mobileLabels.DECOMISO_MOTIVO[inc.motivo] || inc.motivo %></div><% } %>
                </td>
                <td><%= inc.descripcion || '—' %></td>
                <td><%= inc.costo != null ? inc.costo : '—' %></td>
                <td>
                  <% if (inc.tipo !== 'reparacion' && inc.tipo !== 'decomiso') { %>
                    —
                  <% } else if (inc.fecha_resolucion) { %>
                    Sí (<%= inc.fecha_resolucion %>)
                  <% } else { %>
                    No
                  <% } %>
                </td>
                <td>
                  <% if (currentUser.role !== 'lector' && inc.tipo === 'reparacion' && !inc.fecha_resolucion) { %>
                    <form action="/celulares/<%= item.id %>/incidentes/<%= inc.id %>/resolver" method="post"
                          onsubmit="return confirm('¿Marcar esta reparación como resuelta? El equipo vuelve a servicio.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-success" type="submit">Marcar resuelta</button>
                    </form>
                  <% } else if (currentUser.role !== 'lector' && inc.tipo === 'decomiso' && !inc.fecha_resolucion) { %>
                    <form action="/celulares/<%= item.id %>/incidentes/<%= inc.id %>/resolver" method="post"
                          onsubmit="return confirm('¿Resolver el decomiso? El celular vuelve a stock<%= currentAssignment ? ' y se cierra su asignación actual' : '' %>. Si no va a volver, registre una baja en su lugar.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-success" type="submit">Resolver decomiso</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>

      <% if (currentUser.role !== 'lector') { %>
        <button class="btn btn-sm btn-outline-danger mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#formIncidente">
          Registrar incidente
        </button>
        <div class="collapse mt-2" id="formIncidente">
          <form action="/celulares/<%= item.id %>/incidentes" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-2">
              <label class="form-label small">Tipo *</label>
              <select name="tipo" class="form-select form-select-sm" required onchange="var m=this.form.querySelector('.motivo-decomiso'); m.hidden=this.value!=='decomiso'; m.querySelector('select').required=this.value==='decomiso';">
                <option value="reparacion">Reparación</option>
                <option value="accidente">Accidente (registro informativo)</option>
                <% if (item.status !== 'en_decomiso' && item.status !== 'de_baja') { %>
                  <option value="decomiso">Decomiso (denuncia, investigación u observado)</option>
                <% } %>
                <option value="baja">Baja por daño o pérdida</option>
              </select>
            </div>
            <div class="mb-2 motivo-decomiso" hidden>
              <label class="form-label small">Motivo del decomiso *</label>
              <select name="motivo" class="form-select form-select-sm">
                <option value="">— Seleccionar —</option>
                <% Object.keys(mobileLabels.DECOMISO_MOTIVO).forEach(function(k) { %>
                  <option value="<%= k %>"><%= mobileLabels.DECOMISO_MOTIVO[k] %></option>
                <% }); %>
              </select>
              <div class="form-text">El equipo queda "En decomiso" y no se puede asignar hasta resolverlo; al resolverlo vuelve a stock.</div>
            </div>

            <div class="mb-2">
              <label class="form-label small">Fecha *</label>
              <input type="date" name="fecha" class="form-control form-control-sm" required value="<%= new Date().toISOString().slice(0,10) %>">
            </div>
            <div class="mb-2">
              <label class="form-label small">Descripción</label>
              <textarea name="descripcion" class="form-control form-control-sm" rows="2" placeholder="Qué pasó, causa del daño, taller, etc."></textarea>
            </div>
            <div class="mb-2">
              <label class="form-label small">Costo (opcional)</label>
              <input type="number" step="0.01" min="0" name="costo" class="form-control form-control-sm">
            </div>
            <button type="submit" class="btn btn-sm btn-danger">Guardar incidente</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card p-3 mb-3">
      <h5>Asignación actual</h5>
      <% if (currentAssignment) { %>
        <table class="table table-sm">
          <tr><th style="width:140px;">Usuario</th><td><%= currentAssignment.holder_name %></td></tr>
          <tr><th>DNI</th><td><%= currentAssignment.dni || '—' %></td></tr>
          <tr><th>Cargo</th><td><%= currentAssignment.cargo || '—' %></td></tr>
          <tr><th>Turno</th><td><%= currentAssignment.turno || '—' %></td></tr>
          <tr><th>Fecha de entrega</th><td><%= currentAssignment.assigned_date || '—' %></td></tr>
          <tr><th>Observación</th><td><%= currentAssignment.observacion || '—' %></td></tr>
          <tr><th>Solicitado por</th><td>
            <% if (currentAssignment.requested_by_name) { %>
              <%= currentAssignment.requested_by_name %><%= currentAssignment.requested_by_cargo ? ' (' + currentAssignment.requested_by_cargo + ')' : '' %>
              <div class="small text-muted"><%= currentAssignment.requested_by_area || '' %><%= currentAssignment.requested_by_area ? ' · ' : '' %><%= currentAssignment.request_date %><%= currentAssignment.request_ref ? ' · Ref. ' + currentAssignment.request_ref : '' %></div>
            <% } else { %><span class="text-muted">Sin registro (complételo con "Corregir datos del usuario")</span><% } %>
          </td></tr>
        </table>
      <% } else { %>
        <p class="text-muted">Sin asignar (en stock).</p>
      <% } %>

      <% if (currentUser.role !== 'lector') { %>
        <% if (currentAssignment) { %>
          <form action="/celulares/<%= item.id %>/devolver" method="post" class="mb-2"
                onsubmit="return confirm('¿Devolver este celular a stock?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit">Devolver a stock</button>
          </form>
          <button class="btn btn-outline-primary btn-sm mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#formEditarUsuario">
            <i class="bi bi-pencil"></i> Corregir datos del usuario
          </button>
          <div class="collapse mb-3" id="formEditarUsuario">
            <div class="border rounded p-2 bg-light">
              <div class="form-text mb-2">
                Para corregir un error de tipeo (no cambia de persona: para eso usa Reasignar).
                Cada cambio queda registrado en Auditoría.
                <% if (!currentAssignment.employee_id) { %>
                  <br><strong>Este usuario se importó como texto ("<%= currentAssignment.holder_name %>")</strong>:
                  completa DNI, nombres y apellidos para vincularlo al directorio de empleados.
                <% } %>
              </div>
              <form action="/celulares/<%= item.id %>/usuario" method="post"
                    onsubmit="return confirm('¿Guardar la corrección de estos datos? Se sobrescribirán los datos actuales y quedará en Auditoría.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-2">
                  <label class="form-label small">DNI *</label>
                  <input type="text" name="dni" class="form-control form-control-sm" required
                    inputmode="numeric" pattern="\d{8}" maxlength="8" title="8 dígitos numéricos"
                    value="<%= currentAssignment.dni || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Nombres *</label>
                  <input type="text" name="first_name" class="form-control form-control-sm" required maxlength="100"
                    value="<%= currentAssignment.emp_first_name || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Apellidos *</label>
                  <input type="text" name="last_name" class="form-control form-control-sm" required maxlength="100"
                    value="<%= currentAssignment.emp_last_name || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Cargo</label>
                  <input type="text" name="cargo" class="form-control form-control-sm" maxlength="150" value="<%= currentAssignment.cargo || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Turno</label>
                  <input type="text" name="turno" class="form-control form-control-sm" maxlength="50" value="<%= currentAssignment.turno || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Fecha de entrega</label>
                  <input type="date" name="assigned_date" class="form-control form-control-sm" value="<%= currentAssignment.assigned_date || '' %>">
                </div>
                <div class="mb-2">
                  <label class="form-label small">Observación</label>
                  <input type="text" name="observacion" class="form-control form-control-sm" value="<%= currentAssignment.observacion || '' %>">
                </div>
                <%- include('../partials/requester_fields', { requesterOptions: requesterOptions, prefix: 'req_', required: false,
                      value: { name: currentAssignment.requested_by_name, cargo: currentAssignment.requested_by_cargo, area: currentAssignment.requested_by_area,
                               date: currentAssignment.request_date, ref: currentAssignment.request_ref } }) %>
                <button type="submit" class="btn btn-sm btn-primary">Guardar corrección</button>
              </form>
            </div>
          </div>
        <% } %>
        <% if (item.status === 'en_decomiso' || item.status === 'de_baja') { %>
          <div class="alert alert-light border small mb-0">
            <%= item.status === 'en_decomiso' ? 'El celular está en decomiso: no se puede asignar hasta resolverlo (ver incidentes).' : 'El celular está dado de baja: no se puede asignar.' %>
          </div>
        <% } else { %>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#formAsignar">
          <%= currentAssignment ? 'Reasignar' : 'Asignar' %>
        </button>
        <div class="collapse mt-2 <%= dniQuery ? 'show' : '' %>" id="formAsignar">
          <form method="get" action="/celulares/<%= item.id %>" class="d-flex gap-2 mb-3">
            <input type="text" name="dni" class="form-control form-control-sm" placeholder="Buscar empleado por DNI..." value="<%= dniQuery %>">
            <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Buscar</button>
          </form>

          <form action="/celulares/<%= item.id %>/asignar" method="post"
                <%- currentAssignment ? 'onsubmit="return confirm(\'¿Reasignar este celular? Se cerrará la asignación actual y se creará una nueva.\');"' : '' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-2">
              <label class="form-label small">DNI *</label>
              <input type="text" name="dni" class="form-control form-control-sm" required
                value="<%= foundEmployee ? foundEmployee.dni : dniQuery %>">
            </div>
            <div class="mb-2">
              <label class="form-label small">Nombres *</label>
              <input type="text" name="first_name" class="form-control form-control-sm" required
                value="<%= foundEmployee ? foundEmployee.first_name : '' %>">
            </div>
            <div class="mb-2">
              <label class="form-label small">Apellidos *</label>
              <input type="text" name="last_name" class="form-control form-control-sm" required
                value="<%= foundEmployee ? foundEmployee.last_name : '' %>">
            </div>
            <div class="mb-2">
              <label class="form-label small">Área *</label>
              <% const assignArea = foundEmployee ? (foundEmployee.area || '') : ''; %>
              <% const assignAreaEsOtro = assignArea && !areas.includes(assignArea); %>
              <select name="area" id="assign_area_select" class="form-select form-select-sm" required
                      onchange="document.getElementById('assign_area_otro').hidden = this.value !== '__otro__';">
                <option value="">— Seleccionar —</option>
                <% areas.forEach(function(a) { %>
                  <option value="<%= a %>" <%= assignArea === a ? 'selected' : '' %>><%= a %></option>
                <% }); %>
                <option value="<%= assignAreaEsOtro ? assignArea : '__otro__' %>" <%= assignAreaEsOtro ? 'selected' : '' %>>
                  <%= assignAreaEsOtro ? assignArea : 'Otro (especificar)...' %>
                </option>
              </select>
              <input type="text" id="assign_area_otro" class="form-control form-control-sm mt-1" placeholder="Especificar área..." <%= assignAreaEsOtro ? '' : 'hidden' %>
                value="<%= assignAreaEsOtro ? assignArea : '' %>"
                oninput="var o=document.querySelector('#assign_area_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
            </div>
            <div class="mb-2">
              <label class="form-label small">Sede</label>
              <% const assignSede = foundEmployee ? (foundEmployee.sede || '') : ''; %>
              <% const assignSedeEsOtro = assignSede && !sedes.includes(assignSede); %>
              <select name="sede" id="assign_sede_select" class="form-select form-select-sm"
                      onchange="document.getElementById('assign_sede_otro').hidden = this.value !== '__otro__';">
                <option value="">— Seleccionar —</option>
                <% sedes.forEach(function(s) { %>
                  <option value="<%= s %>" <%= assignSede === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
                <option value="<%= assignSedeEsOtro ? assignSede : '__otro__' %>" <%= assignSedeEsOtro ? 'selected' : '' %>>
                  <%= assignSedeEsOtro ? assignSede : 'Otro (especificar)...' %>
                </option>
              </select>
              <input type="text" id="assign_sede_otro" class="form-control form-control-sm mt-1" placeholder="Especificar sede..." <%= assignSedeEsOtro ? '' : 'hidden' %>
                value="<%= assignSedeEsOtro ? assignSede : '' %>"
                oninput="var o=document.querySelector('#assign_sede_select option:last-child'); o.value=this.value; o.textContent=this.value || 'Otro (especificar)...';">
            </div>
            <div class="mb-2">
              <label class="form-label small">Cargo</label>
              <input type="text" name="cargo" class="form-control form-control-sm" value="<%= foundEmployee ? (foundEmployee.cargo || '') : '' %>">
            </div>
            <div class="mb-2">
              <label class="form-label small">Turno</label>
              <input type="text" name="turno" class="form-control form-control-sm" placeholder="Mañana, Tarde...">
            </div>
            <div class="mb-2">
              <label class="form-label small">Fecha de entrega</label>
              <input type="date" name="assigned_date" class="form-control form-control-sm">
            </div>
            <div class="mb-2">
              <label class="form-label small">Observación</label>
              <input type="text" name="observacion" class="form-control form-control-sm">
            </div>
            <%- include('../partials/requester_fields', { requesterOptions: requesterOptions, prefix: 'req_', required: true, value: {} }) %>
            <button type="submit" class="btn btn-sm btn-primary"><%= currentAssignment ? 'Confirmar reasignación' : 'Confirmar asignación' %></button>
          </form>
        </div>
        <% } %>
      <% } %>
    </div>

    <div class="card p-3 mb-3 text-center">
      <h5 class="text-start">Código QR</h5>
      <img src="/celulares/<%= item.id %>/qr.png" alt="Código QR del celular <%= item.imei %>" width="180" height="180" class="mx-auto d-block border rounded p-1 bg-white">
      <div class="form-text mt-1">Al leerlo se obtiene el IMEI, número de línea, modelo y código de activo.</div>
      <a href="/celulares/<%= item.id %>/qr.png?download=1" class="btn btn-sm btn-outline-secondary mt-2">
        <i class="bi bi-download"></i> Descargar QR
      </a>
    </div>

    <div class="card p-3">
      <h5>Adjuntos</h5>
      <% if (currentUser.role !== 'lector') { %>
        <form action="/adjuntos/subir/mobile_device/<%= item.id %>" method="post" enctype="multipart/form-data" class="mb-3 border-bottom pb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-2">
            <select name="doc_type" class="form-select form-select-sm">
              <option value="contrato">Contrato</option>
              <option value="adenda">Adenda</option>
              <option value="factura">Factura</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="mb-2">
            <input type="text" name="description" class="form-control form-control-sm" placeholder="Descripción (opcional)">
          </div>
          <div class="mb-2">
            <input type="file" name="file" class="form-control form-control-sm" required>
          </div>
          <button type="submit" class="btn btn-sm btn-primary">Subir archivo</button>
        </form>
      <% } %>
      <ul class="list-group list-group-flush">
        <% attachments.forEach(function(a) { %>
          <%- include('../partials/attachment_item', { a: a }) %>
        <% }); %>
        <% if (attachments.length === 0) { %>
          <li class="list-group-item px-0 text-muted">Sin archivos adjuntos.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
