<%- include('partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0"><%= title %></h2>
  <a href="<%= listUrl %>" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<% if (results) { %>
  <div class="card p-3 mb-4">
    <h5>Resultado de la importación</h5>
    <p class="mb-2">
      <span class="badge bg-success">Importados: <%= results.imported %></span>
      <span class="badge bg-danger">Con errores: <%= results.errors.length %></span>
    </p>
    <% if (results.errors.length > 0) { %>
      <table class="table table-sm">
        <thead><tr><th style="width:100px;">Fila</th><th>Error</th></tr></thead>
        <tbody>
          <% results.errors.forEach(function(e) { %>
            <tr><td><%= e.row %></td><td><%= e.message %></td></tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>

<div class="card p-4">
  <p class="text-muted">
    Sube un archivo <strong>CSV o Excel (.xlsx)</strong> con una fila de
    encabezados igual a las columnas de abajo. Puedes descargar una
    plantilla en blanco para llenarla.
  </p>

  <a href="<%= templateUrl %>" class="btn btn-outline-primary btn-sm mb-3" style="width:fit-content;">
    <i class="bi bi-download"></i> Descargar plantilla (.xlsx)
  </a>

  <table class="table table-sm mb-4">
    <thead><tr><th>Columna esperada</th><th>Obligatorio</th></tr></thead>
    <tbody>
      <% columns.forEach(function(c) { %>
        <tr><td><%= c.header %></td><td><%= c.required ? 'Sí' : 'No' %></td></tr>
      <% }); %>
    </tbody>
  </table>

  <form method="post" action="<%= actionUrl %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-3">
      <label class="form-label">Archivo (CSV o Excel)</label>
      <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required>
    </div>
    <button type="submit" class="btn btn-primary">Importar</button>
  </form>
</div>

<%- include('partials/foot') %>
