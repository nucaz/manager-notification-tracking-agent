<%- include('../partials/head', { title: title }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0"><%= title %></h2>
  <a href="<%= isNew ? '/clinic' : '/clinic/' + item.id %>" class="btn btn-outline-secondary">Volver</a>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<form method="post" action="<%= isNew ? '/clinic/nuevo' : '/clinic/' + item.id + '/editar' %>" class="card p-4" style="max-width: 860px" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p class="small text-muted">Los campos marcados con * son obligatorios. La contraseña de Clinic no se registra aquí: se crea y se entrega en Clinic.</p>

  <h6 class="text-uppercase small fw-bold text-primary border-start border-3 border-primary ps-2">Datos de acceso</h6>
  <div class="row g-3 mb-3">
    <div class="col-md-6"><label class="form-label" for="full_name">Nombre *</label>
      <input class="form-control" id="full_name" name="full_name" maxlength="150" required placeholder="Nombre completo" value="<%= item.full_name || '' %>"></div>
    <div class="col-md-6"><label class="form-label" for="username">Usuario *</label>
      <input class="form-control font-monospace" id="username" name="username" maxlength="60" required pattern="[A-Za-z0-9._@\-]{2,60}" placeholder="Usuario de acceso" value="<%= item.username || '' %>"></div>
    <div class="col-md-6"><label class="form-label" for="dni">DNI en el directorio de empleados (opcional)</label>
      <input class="form-control" id="dni" name="dni" maxlength="8" inputmode="numeric" pattern="\d{8}" value="<%= item.dni || '' %>">
      <div class="form-text">Vincula el usuario con la persona (ver sus celulares, cuentas y demás).</div></div>
  </div>

  <h6 class="text-uppercase small fw-bold text-primary border-start border-3 border-primary ps-2">Perfil y ubicación</h6>
  <div class="row g-3 mb-3">
    <div class="col-md-6"><label class="form-label" for="perfil">Perfil *</label>
      <select class="form-select" id="perfil" name="perfil" required>
        <option value="">— Seleccionar —</option>
        <% perfiles.forEach(function (p) { %><option <%= item.perfil === p ? 'selected' : '' %>><%= p %></option><% }); %>
        <% if (item.perfil && !perfiles.includes(item.perfil)) { %><option selected><%= item.perfil %></option><% } %>
      </select>
      <% if (!perfiles.length) { %><div class="form-text text-danger">No hay perfiles en el catálogo: agréguelos en Configuración &gt; Catálogos &gt; Perfiles de Clinic, o importe el listado de Clinic.</div><% } %></div>
    <div class="col-md-6"><label class="form-label" for="sede">Sede *</label>
      <select class="form-select" id="sede" name="sede" required>
        <option value="">— Seleccionar —</option>
        <% sedes.forEach(function (s) { %><option <%= item.sede === s ? 'selected' : '' %>><%= s %></option><% }); %>
        <% if (item.sede && !sedes.includes(item.sede)) { %><option selected><%= item.sede %></option><% } %>
      </select></div>
    <div class="col-md-6"><label class="form-label" for="area">Área</label>
      <select class="form-select" id="area" name="area">
        <option value="">— Sin área —</option>
        <% areas.forEach(function (a) { %><option <%= item.area === a ? 'selected' : '' %>><%= a %></option><% }); %>
        <% if (item.area && !areas.includes(item.area)) { %><option selected><%= item.area %></option><% } %>
      </select></div>
    <div class="col-md-6"><label class="form-label" for="status">Estado</label>
      <% if (item.status === 'baja') { %>
        <input class="form-control" id="status" value="De baja (use Reactivar en la ficha)" disabled>
      <% } else { %>
        <select class="form-select" id="status" name="status">
          <option value="activo" <%= item.status !== 'inactivo' ? 'selected' : '' %>>ACTIVO</option>
          <option value="inactivo" <%= item.status === 'inactivo' ? 'selected' : '' %>>INACTIVO</option>
        </select>
      <% } %></div>
  </div>

  <h6 class="text-uppercase small fw-bold text-primary border-start border-3 border-primary ps-2">Supervisión y aprobación</h6>
  <div class="row g-3 mb-3 align-items-end">
    <div class="col-md-6"><label class="form-label" for="supervisor_id">Supervisor</label>
      <select class="form-select" id="supervisor_id" name="supervisor_id">
        <option value="">Sin supervisor asignado</option>
        <% supervisors.forEach(function (s) { %><option value="<%= s.id %>" <%= Number(item.supervisor_id) === s.id ? 'selected' : '' %>><%= s.full_name || s.username %> (<%= s.username %>)</option><% }); %>
      </select></div>
    <div class="col-md-6">
      <div class="form-check border rounded-pill px-4 py-2 d-inline-block">
        <input class="form-check-input" type="checkbox" id="approved" name="approved" value="1" <%= Number(item.approved) ? 'checked' : '' %>>
        <label class="form-check-label" for="approved">Usuario aprobado</label>
      </div></div>
  </div>

  <% if (isNew) { %>
    <%- include('../partials/requester_fields', { requesterOptions: requesterOptions, prefix: 'req_', required: true, value: requester }) %>
  <% } %>

  <div class="mb-3"><label class="form-label" for="notes">Notas</label>
    <textarea class="form-control" id="notes" name="notes" rows="2" maxlength="2000"><%= item.notes || '' %></textarea></div>

  <div><button class="btn btn-primary" type="submit"><%= isNew ? 'Registrar usuario' : 'Guardar cambios' %></button></div>
</form>

<%- include('../partials/foot') %>
