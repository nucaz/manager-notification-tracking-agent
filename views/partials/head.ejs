<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' — ' + appName : appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<nav class="sidebar" id="sidebar">
  <a href="/" class="sidebar-brand"><i class="bi bi-shield-lock fs-5"></i> <span><%= appName %></span></a>
  <ul class="sidebar-nav">
    <li><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/"><i class="bi bi-speedometer2"></i> <span>Panel</span></a></li>
    <% if (enabledModules.licencias) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/licencias') ? 'active' : '' %>" href="/licencias"><i class="bi bi-key"></i> <span>Licencias</span></a></li>
    <% } %>
    <% if (enabledModules.dominios) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/dominios') ? 'active' : '' %>" href="/dominios"><i class="bi bi-globe"></i> <span>Dominios</span></a></li>
    <% } %>
    <% if (enabledModules.isp) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/isp') ? 'active' : '' %>" href="/isp"><i class="bi bi-wifi"></i> <span>Contratos ISP</span></a></li>
    <% } %>
    <% if (enabledModules.servidores) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/servidores') ? 'active' : '' %>" href="/servidores"><i class="bi bi-hdd-rack"></i> <span>Servidores</span></a></li>
    <% } %>
    <% if (enabledModules.certificados) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/certificados') ? 'active' : '' %>" href="/certificados"><i class="bi bi-patch-check"></i> <span>Certificados</span></a></li>
    <% } %>
    <% if (enabledModules.celulares) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/celulares') ? 'active' : '' %>" href="/celulares"><i class="bi bi-phone"></i> <span>Celulares</span></a></li>
    <% } %>
    <% if (enabledModules.empleados) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/empleados') ? 'active' : '' %>" href="/empleados"><i class="bi bi-people"></i> <span>Empleados</span></a></li>
    <% } %>
    <% if (enabledModules.red) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/red') ? 'active' : '' %>" href="/red"><i class="bi bi-diagram-3"></i> <span>Red</span></a></li>
    <% } %>
    <% if (enabledModules.glpi_inventario) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/glpi/inventario') ? 'active' : '' %>" href="/glpi/inventario"><i class="bi bi-boxes"></i> <span>Inventario GLPI</span></a></li>
    <% } %>
    <% if (enabledModules.reportes) { %>
    <li><a class="nav-link <%= currentPath.startsWith('/reportes') ? 'active' : '' %>" href="/reportes"><i class="bi bi-bar-chart"></i> <span>Reportes</span></a></li>
    <% } %>
    <% if (currentUser.role === 'admin') { %>
    <li class="sidebar-section">Administración</li>
    <li><a class="nav-link <%= currentPath.startsWith('/usuarios') ? 'active' : '' %>" href="/usuarios"><i class="bi bi-person-gear"></i> <span>Usuarios</span></a></li>
    <li><a class="nav-link <%= currentPath.startsWith('/permisos') ? 'active' : '' %>" href="/permisos"><i class="bi bi-shield-lock"></i> <span>Permisos</span></a></li>
    <li><a class="nav-link <%= currentPath.startsWith('/auditoria') ? 'active' : '' %>" href="/auditoria"><i class="bi bi-clock-history"></i> <span>Auditoría</span></a></li>
    <li><a class="nav-link <%= currentPath.startsWith('/historial-chat') ? 'active' : '' %>" href="/historial-chat"><i class="bi bi-chat-dots"></i> <span>Historial de chat</span></a></li>
    <li><a class="nav-link <%= currentPath.startsWith('/configuracion') ? 'active' : '' %>" href="/configuracion"><i class="bi bi-gear"></i> <span>Configuración</span></a></li>
    <li>
      <a class="nav-link" href="http://<%= currentHost %>:8091" target="_blank" rel="noopener">
        <i class="bi bi-hdd-network"></i> <span>DevOps <i class="bi bi-box-arrow-up-right small"></i></span>
      </a>
    </li>
    <% } %>
  </ul>
  <div class="sidebar-user">
    <a href="/mi-cuenta" class="sidebar-user-link <%= currentPath.startsWith('/mi-cuenta') ? 'active' : '' %>">
      <i class="bi bi-person-circle"></i>
      <span><%= currentUser.full_name %><br><span class="badge bg-secondary text-uppercase"><%= currentUser.role %></span></span>
    </a>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="sidebar-toggle text-danger" type="submit"><i class="bi bi-box-arrow-right"></i> <span>Salir</span></button>
    </form>
  </div>
  <button class="sidebar-toggle" id="sidebarToggle" title="Colapsar/expandir menú">
    <i class="bi bi-layout-sidebar-inset"></i> <span>Colapsar</span>
  </button>
  <div class="sidebar-resizer" id="sidebarResizer" title="Arrastra para cambiar el ancho del menú"></div>
</nav>
<script>
(function () {
  const sidebar = document.getElementById('sidebar');
  const toggle = document.getElementById('sidebarToggle');
  const resizer = document.getElementById('sidebarResizer');
  const MIN_W = 180;
  const MAX_W = 420;

  let collapsed = false;
  try { collapsed = localStorage.getItem('glpiSidebarCollapsed') === '1'; } catch (e) {}
  if (collapsed) { sidebar.classList.add('collapsed'); }

  let savedWidth = null;
  try { savedWidth = parseInt(localStorage.getItem('glpiSidebarWidth'), 10); } catch (e) {}
  if (savedWidth && savedWidth >= MIN_W && savedWidth <= MAX_W) {
    document.documentElement.style.setProperty('--sidebar-w', savedWidth + 'px');
  }

  toggle.addEventListener('click', () => {
    if (window.innerWidth <= 768) {
      sidebar.classList.toggle('mobile-open');
      return;
    }
    sidebar.classList.toggle('collapsed');
    try { localStorage.setItem('glpiSidebarCollapsed', sidebar.classList.contains('collapsed') ? '1' : '0'); } catch (e) {}
  });

  resizer.addEventListener('mousedown', (ev) => {
    if (window.innerWidth <= 768 || sidebar.classList.contains('collapsed')) return;
    ev.preventDefault();
    sidebar.classList.add('resizing');

    function onMouseMove(moveEv) {
      const width = Math.min(MAX_W, Math.max(MIN_W, moveEv.clientX));
      document.documentElement.style.setProperty('--sidebar-w', width + 'px');
    }
    function onMouseUp() {
      sidebar.classList.remove('resizing');
      document.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseup', onMouseUp);
      const finalWidth = sidebar.getBoundingClientRect().width;
      try { localStorage.setItem('glpiSidebarWidth', String(Math.round(finalWidth))); } catch (e) {}
    }
    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
  });
})();
</script>
<% } %>
<% if (currentUser) { %><div class="main-content"><% } %>
<div class="container-fluid px-4 pb-5">
  <% if (typeof successMessages !== 'undefined' && successMessages.length) { %>
    <% successMessages.forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }); %>
  <% } %>
  <% if (typeof errorMessages !== 'undefined' && errorMessages.length) { %>
    <% errorMessages.forEach(function(msg) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }); %>
  <% } %>
