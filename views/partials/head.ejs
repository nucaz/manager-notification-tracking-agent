<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' — ' + appName : appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="bi bi-shield-lock"></i> <%= appName %></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Panel</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/licencias') ? 'active' : '' %>" href="/licencias">Licencias</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/dominios') ? 'active' : '' %>" href="/dominios">Dominios</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/isp') ? 'active' : '' %>" href="/isp">Contratos ISP</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/servidores') ? 'active' : '' %>" href="/servidores">Servidores</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/certificados') ? 'active' : '' %>" href="/certificados">Certificados</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/celulares') ? 'active' : '' %>" href="/celulares">Celulares</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/red') ? 'active' : '' %>" href="/red">Red</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/reportes') ? 'active' : '' %>" href="/reportes">Reportes</a></li>
        <% if (currentUser.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/usuarios') ? 'active' : '' %>" href="/usuarios">Usuarios</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/configuracion') ? 'active' : '' %>" href="/configuracion">Configuración</a></li>
        <% } %>
      </ul>
      <span class="navbar-text me-3">
        <i class="bi bi-person-circle"></i> <%= currentUser.full_name %>
        <span class="badge bg-secondary text-uppercase"><%= currentUser.role %></span>
      </span>
      <form action="/logout" method="post" class="d-flex">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
      </form>
    </div>
  </div>
</nav>
<% } %>
<div class="container-fluid px-4 pb-5">
  <% if (typeof successMessages !== 'undefined' && successMessages.length) { %>
    <% successMessages.forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }); %>
  <% } %>
  <% if (typeof errorMessages !== 'undefined' && errorMessages.length) { %>
    <% errorMessages.forEach(function(msg) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }); %>
  <% } %>
