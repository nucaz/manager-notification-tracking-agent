# ==========================================================================
# Configuracion de entorno - copiar a .env y completar antes de iniciar
# ==========================================================================

# --- Aplicacion ---
NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

# --- Base de datos MySQL/MariaDB ---
DB_HOST=db
DB_PORT=3306
DB_NAME=licencias_app
DB_USER=licencias
DB_PASSWORD=cambia_este_password

# --- Usuario administrador inicial (creado por npm run seed) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@depilzone.com.pe
ADMIN_PASSWORD=cambia_este_password_admin

# --- SMTP para recordatorios (tambien editable desde la UI de Configuracion) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=monitoreo@depilzone.com.pe

# --- GLPI (tambien editable desde la UI de Configuracion) ---
# URL base de la API REST "Legacy" de GLPI. NO asumas la ruta: varia segun
# la version de GLPI (versiones viejas: /apirest.php ; GLPI 10/11 con la
# API nueva en paralelo: /api.php/v1). Copia el valor EXACTO que muestra
# tu propio servidor en Configuracion > General > API > "URL of the API"
# dentro de la seccion "Legacy API" (no la de "API" nueva v2.x, que usa un
# protocolo distinto no soportado por esta app), y agrega tu dominio real,
# ej: https://tu-servidor.tudominio.com/api.php/v1
GLPI_BASE_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# --- Carga de archivos ---
UPLOAD_MAX_MB=25
