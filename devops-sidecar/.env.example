# ==========================================================================
# DevOps Sidecar - configuracion de entorno. Copiar a .env y completar.
# ==========================================================================

# --- Seguridad ---
# Token que debes configurar TAMBIEN en Coolify (Notifications -> Webhook
# -> Custom Headers, header "X-Webhook-Token") para que el webhook no
# acepte llamadas de cualquiera. Invéntalo tú mismo (texto largo al azar).
WEBHOOK_SECRET=cambia_este_token_por_uno_largo_y_unico

# Usuario/contraseña para entrar al dashboard (HTTP Basic Auth).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia_esta_password

# --- Proveedor de IA para el motor de auditoria (elige uno) ---
AI_PROVIDER=gemini

# Gemini: la misma API key que ya usas en glpi-licencias-app (Configuracion
# -> Extraccion de facturas con IA) sirve aca tambien - genera una nueva
# en https://aistudio.google.com/apikey si prefieres una separada.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Claude (Anthropic) - alternativa a Gemini. API key en console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama local - alternativa sin costo/llaves, requiere tener Ollama
# instalado y accesible desde el contenedor.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Rutas (ya vienen mapeadas via volumenes en docker-compose.yml, no
#     hace falta tocarlas salvo que cambies los volumenes) ---
REPOS_BASE_PATH=/data/repos
BACKUPS_PATH=/data/backups
REPORTS_PATH=/data/reports
DATABASE_PATH=/data/db/sidecar.db

# --- Programacion (hora del servidor) ---
AUDIT_HOUR=18
AUDIT_MINUTE=0
WEEKLY_BACKUP_DAY_OF_WEEK=sun
WEEKLY_BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
