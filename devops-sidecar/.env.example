# ==========================================================================
# DevOps Sidecar - configuracion de entorno. Copiar a .env y completar.
# ==========================================================================

# --- Seguridad ---
# Token que debes incluir TAMBIEN en la URL del webhook que configures en
# Coolify (Notifications -> Webhook -> Webhook URL), como
# https://tu-servidor:8091/webhooks/coolify?token=ESTE_VALOR - Coolify NO
# soporta headers personalizados en este canal (verificado en su codigo
# fuente: WebhookNotificationSettings solo tiene el campo webhook_url),
# por eso el token va en la URL y no en un header. Invéntalo tú mismo
# (texto largo al azar).
WEBHOOK_SECRET=cambia_este_token_por_uno_largo_y_unico

# Usuario/contraseña para entrar al dashboard (HTTP Basic Auth).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia_esta_password

# Clave Fernet (urlsafe-base64 de 32 bytes) para cifrar en la base de
# datos las API keys de IA guardadas desde el dashboard. Generarla con:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# o sin Python: openssl rand 32 | base64 | tr '+/' '-_'
# Si se deja vacia, esas API keys quedan en texto plano en la BD (no
# rompe nada - sigue funcionando igual hasta que la agregues y
# reinicies el contenedor).
CREDENTIALS_ENC_KEY=

# Acceso unico con la aplicacion principal (un solo usuario para las dos):
# el MISMO valor que SSO_SHARED_SECRET del .env de la raiz. Con esto se
# entra desde el menu DevOps de la aplicacion principal (su usuario, captcha
# y 2FA) y el usuario/contrasena de arriba quedan apagados.
# Generar: openssl rand -hex 32. Vacio = solo HTTP Basic, como antes.
SSO_SHARED_SECRET=
# auto (predeterminado) | on (mantener HTTP Basic como entrada de emergencia) | off
DASHBOARD_BASIC_AUTH=auto

# --- IA: configuracion unica ---
# Con SSO_SHARED_SECRET configurado, la IA se configura en la aplicacion
# principal (Configuracion > Inteligencia artificial) y este modulo le pide
# que genere por el, por la red interna de Docker. Direccion de la app
# principal dentro de esa red (el servicio "app" escucha en 3000):
MAIN_APP_INTERNAL_URL=http://app:3000

# --- IA de emergencia: solo si la aplicacion principal no responde ---
AI_PROVIDER=gemini

# Gemini: genera una API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Claude (Anthropic) - alternativa a Gemini. API key en console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama local - alternativa sin costo/llaves, requiere tener Ollama
# instalado y accesible desde el contenedor.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Rutas (ya vienen mapeadas via volumenes en docker-compose.yml, no
#     hace falta tocarlas salvo que cambies los volumenes) ---
REPOS_BASE_PATH=/data/repos
BACKUPS_PATH=/data/backups
REPORTS_PATH=/data/reports
DATABASE_PATH=/data/db/sidecar.db

# --- Programacion (hora del servidor) ---
AUDIT_HOUR=18
AUDIT_MINUTE=0
WEEKLY_BACKUP_DAY_OF_WEEK=sun
WEEKLY_BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
